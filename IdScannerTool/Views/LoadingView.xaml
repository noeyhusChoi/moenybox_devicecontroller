<UserControl
    x:Class="IdScannerTool.Views.LoadingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="12">
        <ui:Card
            Width="480"
            Height="270"
            Padding="24">
            <StackPanel>
                <!--<ui:TextBlock
                    Margin="0,0,0,10"
                    FontTypography="Subtitle"
                    Text="프로그램 실행 중" />-->

                <ui:Card Margin="0,0,0,10" Padding="16">
                    <StackPanel>
                        <Grid Height="32" Margin="0,0,0,4">
                            <ProgressBar
                                Height="5"
                                Margin="60,0"
                                IsIndeterminate="True"
                                Visibility="{Binding CurrentStage.IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ui:SymbolIcon
                                FontSize="32"
                                Symbol="DismissSquare24"
                                Visibility="{Binding CurrentStage.IsFailed, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <ui:TextBlock
                            Margin="2"
                            HorizontalAlignment="Center"
                            FontTypography="BodyStrong"
                            Text="{Binding CurrentStage.Title}" />
                        <ui:TextBlock
                            Margin="2"
                            HorizontalAlignment="Center"
                            FontTypography="Caption"
                            Text="{Binding CurrentStage.Message}" />
                    </StackPanel>
                </ui:Card>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button
                        Grid.Column="1"
                        Width="110"
                        Height="34"
                        Appearance="Secondary"
                        Command="{Binding CancelCommand}"
                        Content="프로그램 종료" />

                    <ui:Button
                        Grid.Column="3"
                        Width="110"
                        Height="34"
                        Appearance="Primary"
                        Command="{Binding RetryCommand}"
                        Content="재시도"
                        IsEnabled="{Binding IsRetryEnabled}" />
                </Grid>
            </StackPanel>
        </ui:Card>
    </Grid>
</UserControl>
