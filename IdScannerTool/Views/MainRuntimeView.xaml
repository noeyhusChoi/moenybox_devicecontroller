<UserControl
    x:Class="IdScannerTool.Views.MainRuntimeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:devices="clr-namespace:DeviceKit.Status;assembly=DeviceKit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Grid Margin="12,0,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>



        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:TextBlock
                Margin="0,0,0,12"
                HorizontalAlignment="Left"
                Appearance="Primary"
                FontTypography="Title"
                Text="신분증 인식 목록" />

            <ui:Card
                Grid.Column="1"
                Margin="0,12"
                Padding="10,4"
                HorizontalAlignment="Right">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#9CA3AF" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static devices:DeviceConnectionState.Connected}">
                                        <Setter Property="Fill" Value="#16A34A" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static devices:DeviceConnectionState.Disconnected}">
                                        <Setter Property="Fill" Value="#DC2626" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static devices:DeviceConnectionState.Connecting}">
                                        <Setter Property="Fill" Value="#CA8A04" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static devices:DeviceConnectionState.Faulted}">
                                        <Setter Property="Fill" Value="#DC2626" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <ui:TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold">
                        <ui:TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="연결 대기" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static devices:DeviceConnectionState.Connected}">
                                        <Setter Property="Text" Value="정상 연결" />
                                        <Setter Property="Foreground" Value="#16A34A" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static devices:DeviceConnectionState.Disconnected}">
                                        <Setter Property="Text" Value="연결 오류" />
                                        <Setter Property="Foreground" Value="#DC2626" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static devices:DeviceConnectionState.Connecting}">
                                        <Setter Property="Text" Value="연결 중" />
                                        <Setter Property="Foreground" Value="#CA8A04" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static devices:DeviceConnectionState.Faulted}">
                                        <Setter Property="Text" Value="장치 오류" />
                                        <Setter Property="Foreground" Value="#DC2626" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:TextBlock.Style>
                    </ui:TextBlock>
                </StackPanel>
            </ui:Card>
        </Grid>

        <ui:Card
            Grid.Row="2"
            Margin="0"
            Padding="16"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>



                <Grid
                    Grid.Row="1"
                    Margin="0,0,0,16"
                    VerticalAlignment="Center"
                    Cursor="">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <ui:TextBlock
                            Margin="0,0,0,4"
                            FontTypography="Caption"
                            Text="고객명" />
                        <ui:TextBox Height="36" Text="{Binding SearchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <ui:TextBlock
                            Margin="0,0,0,4"
                            FontTypography="Caption"
                            Text="실명번호" />
                        <ui:TextBox Height="36" Text="{Binding SearchNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <ui:TextBlock
                            Margin="0,0,0,4"
                            FontTypography="Caption"
                            Text="시작일" />
                        <DatePicker
                            Height="36"
                            Language="en-CA"
                            SelectedDate="{Binding SearchStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedDateFormat="Short" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <ui:TextBlock
                            Margin="0,0,0,4"
                            FontTypography="Caption"
                            Text="종료일" />
                        <DatePicker
                            Height="36"
                            Language="en-CA"
                            SelectedDate="{Binding SearchEndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedDateFormat="Short" />
                    </StackPanel>

                    <ui:Button
                        Grid.Column="4"
                        Height="36"
                        Margin="4,0"
                        VerticalAlignment="Bottom"
                        Appearance="Primary"
                        Command="{Binding SearchHistoryCommand}"
                        Content="검색"
                        Icon="{ui:SymbolIcon Search24}"
                        ToolTip="검색" />

                    <ui:Button
                        Grid.Column="5"
                        Height="36"
                        Margin="4,0"
                        VerticalAlignment="Bottom"
                        Appearance="Secondary"
                        Command="{Binding ClearHistoryFilterCommand}"
                        Content="초기화"
                        Icon="{ui:SymbolIcon ArrowClockwise24}"
                        ToolTip="초기화" />
                </Grid>

                <ui:DataGrid
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="False"
                    ItemsSource="{Binding OcrHistory}"
                    RowHeight="34"
                    SelectedItem="{Binding SelectedOcrHistory, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn
                            MinWidth="56"
                            MaxWidth="56"
                            Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            CanUserSort="False">
                            <DataGridCheckBoxColumn.Header>
                                <CheckBox
                                    Margin="0,0"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    IsChecked="{Binding DataContext.IsAllHistorySelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                            Header="일자"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="160"
                            Binding="{Binding Name}"
                            Header="고객명"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="80"
                            MinWidth="80"
                            Binding="{Binding DocumentType}"
                            Header="문서유형"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="200"
                            MinWidth="80"
                            Binding="{Binding DocumentNo}"
                            Header="실명번호"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="160"
                            MinWidth="80"
                            Binding="{Binding Nationality}"
                            Header="국적부호"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="80"
                            MinWidth="80"
                            Binding="{Binding Sex}"
                            Header="성별"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="160"
                            MinWidth="100"
                            Binding="{Binding BirthDate}"
                            Header="생년월일"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="160"
                            MinWidth="100"
                            Binding="{Binding ExpiryDate}"
                            Header="만료일자"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn
                            MinWidth="52"
                            MaxWidth="52"
                            Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button
                                        Width="38"
                                        Height="26"
                                        HorizontalAlignment="Center"
                                        Appearance="Secondary"
                                        Command="{Binding DataContext.DeleteHistoryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon Delete24}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </ui:DataGrid>

                <StackPanel
                    Grid.Row="3"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:Button
                        Height="36"
                        Margin="0,0,8,0"
                        VerticalAlignment="Stretch"
                        Appearance="Secondary"
                        Command="{Binding DeleteSelectedHistoryCommand}"
                        Content="선택 삭제" />
                    <ui:Button
                        Height="36"
                        VerticalAlignment="Stretch"
                        Appearance="Primary"
                        Command="{Binding ExportHistoryToExcelCommand}"
                        Content="엑셀 내려받기" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <Expander
            Grid.Row="3"
            Margin="0"
            Header="Debug"
            IsExpanded="False">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Status" />
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,8,4"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Device" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="12"
                                Text="{Binding DeviceType}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,8,4"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Connection" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="12"
                                Text="{Binding ConnectionState}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,0,4"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Message" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="12"
                                Text="{Binding StatusMessage}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Presence" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="12"
                                Text="{Binding ScanPresence}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Detected" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="12"
                                Text="{Binding IsDetected}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="2"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Polling" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="12"
                                Text="{Binding IsScanPolling}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Command" />
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:Button
                            Width="92"
                            Height="32"
                            Margin="0,0,8,6"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh" />
                        <ui:Button
                            Width="92"
                            Height="32"
                            Margin="0,0,8,6"
                            Command="{Binding ConnectCommand}"
                            Content="Connect" />
                        <ui:Button
                            Width="92"
                            Height="32"
                            Margin="0,0,8,6"
                            Command="{Binding DisconnectCommand}"
                            Content="Disconnect" />
                        <ui:Button
                            Width="92"
                            Height="32"
                            Margin="0,0,8,6"
                            Command="{Binding ScanStartCommand}"
                            Content="ScanStart" />
                        <ui:Button
                            Width="104"
                            Height="32"
                            Margin="0,0,8,6"
                            Command="{Binding GetScanStatusCommand}"
                            Content="GetStatus" />
                        <ui:Button
                            Width="104"
                            Height="32"
                            Margin="0,0,8,6"
                            Command="{Binding SaveImageCommand}"
                            Content="SaveImage" />
                        <ui:Button
                            Width="92"
                            Height="32"
                            Margin="0,0,8,6"
                            Command="{Binding RunOcrCommand}"
                            Content="RunOcr" />
                        <ui:Button
                            Width="104"
                            Height="32"
                            Margin="0,0,8,6"
                            Command="{Binding ReloadHistoryCommand}"
                            Content="ReloadDB" />
                        <ui:Button
                            Width="92"
                            Height="32"
                            Margin="0,0,8,6"
                            Command="{Binding ScanStopCommand}"
                            Content="ScanStop" />
                        <ui:Button
                            Width="92"
                            Height="32"
                            Margin="0,0,8,6"
                            Command="{Binding RestartCommand}"
                            Content="Restart" />
                    </WrapPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Log" />
                    <ui:TextBox
                        Grid.Column="1"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        Text="{Binding LastResult}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Grid>
        </Expander>
    </Grid>
</UserControl>
