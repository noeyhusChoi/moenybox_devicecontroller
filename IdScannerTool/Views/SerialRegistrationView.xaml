<UserControl
    x:Class="IdScannerTool.Views.SerialRegistrationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Padding="16">
            <StackPanel>
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="시리얼 등록 화면" />
                <TextBlock
                    Margin="0,8,0,0"
                    Text="{Binding RegistrationStatusMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>

        <ui:Card
            Grid.Row="1"
            Margin="0,12,0,12"
            Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="로컬 시리얼키" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding RegisteredSerialKey}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,10,0,0"
                    VerticalAlignment="Center"
                    Text="추출 시리얼키" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,10,0,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{Binding ExtractedSerialKey}" />

                <WrapPanel
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,18,0,0">
                    <ui:Button
                        Width="180"
                        Height="38"
                        Margin="0,0,8,8"
                        Appearance="Primary"
                        Command="{Binding ExtractAndPrepareCommand}"
                        Content="장치 연결 + 시리얼 추출" />
                    <ui:Button
                        Width="140"
                        Height="38"
                        Margin="0,0,8,8"
                        Appearance="Primary"
                        Command="{Binding RegisterSerialKeyCommand}"
                        Content="로컬 시리얼 등록" />
                    <ui:Button
                        Width="120"
                        Height="38"
                        Margin="0,0,8,8"
                        Appearance="Secondary"
                        Command="{Binding RetryStartupFlowCommand}"
                        Content="다시 확인" />
                    <ui:Button
                        Width="220"
                        Height="38"
                        Margin="0,0,8,8"
                        Appearance="Secondary"
                        Command="{Binding SkipSerialCheckForDebugCommand}"
                        Content="디버그: 시리얼 체크 건너뛰기" />
                </WrapPanel>
            </Grid>
        </ui:Card>

        <DockPanel Grid.Row="2">
            <TextBlock Text="{Binding IsBusy, StringFormat=Busy: {0}}" />
        </DockPanel>
    </Grid>
</UserControl>
