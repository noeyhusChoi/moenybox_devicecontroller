<Window x:Class="KIOSK.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KIOSK Admin - Device Monitor"
        Height="760"
        Width="1200"
        MinWidth="980"
        MinHeight="620">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="Refresh"
                    Width="96"
                    Height="34"
                    Command="{Binding RefreshCommand}" />
            <TextBlock Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       Text="{Binding SummaryText}" />
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Padding="8">
            <DataGrid ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DeviceId" Binding="{Binding DeviceId}" Width="180" />
                    <DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" Width="120" />
                    <DataGridTextColumn Header="State" Binding="{Binding ConnectionState}" Width="120" />
                    <DataGridCheckBoxColumn Header="Healthy" Binding="{Binding IsHealthy}" Width="90" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="190" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Width="96" Height="34" Content="Connect" Command="{Binding ConnectCommand}" />
                <Button Grid.Row="0" Grid.Column="1" Width="96" Height="34" Margin="8,0,0,0" Content="Disconnect" Command="{Binding DisconnectCommand}" />

                <TextBlock Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Text="Command" />
                <ComboBox Grid.Row="0"
                          Grid.Column="5"
                          Height="32"
                          Margin="8,0,0,0"
                          ItemsSource="{Binding AvailableCommands}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Name"
                          SelectedValue="{Binding SelectedCommandName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="0" Grid.Column="6" Margin="12,0,0,0" VerticalAlignment="Center" Text="Payload" />
                <TextBox Grid.Row="0" Grid.Column="7" Height="32" Margin="8,0,0,0" VerticalContentAlignment="Center" Text="{Binding CommandPayload, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="0" Grid.Column="8" Width="96" Height="34" Margin="12,0,0,0" Content="Execute" Command="{Binding ExecuteCommand}" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="9"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="#444"
                           Text="{Binding LastResult}" />
            </Grid>
        </Border>
    </Grid>
</Window>
