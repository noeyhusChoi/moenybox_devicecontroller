<UserControl
    x:Class="Kiosk.Views.Overlays.ThemeSelectionOverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <Grid
        Background="{DynamicResource OverlayDimBrush}"
        Focusable="False"
        KeyboardNavigation.DirectionalNavigation="Continue"
        KeyboardNavigation.IsTabStop="False">
        <Border
            Width="840"
            Padding="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource CardPrimaryBackgroundBrush}"
            CornerRadius="32">
            <Grid Focusable="False" KeyboardNavigation.IsTabStop="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="127" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="52"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="{Binding Title}" />

                <UniformGrid
                    Grid.Row="2"
                    Columns="2"
                    FocusManager.FocusedElement="{Binding ElementName=DefaultThemeButton}"
                    FocusManager.IsFocusScope="True"
                    Focusable="False"
                    KeyboardNavigation.DirectionalNavigation="Continue"
                    KeyboardNavigation.IsTabStop="False">
                    <Button
                        x:Name="DefaultThemeButton"
                        Width="360"
                        Height="188"
                        Margin="6"
                        Command="{Binding SelectDefaultCommand}">
                        <Button.Style>
                    <Style BasedOn="{StaticResource OutlinedActionSecondaryButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDefaultSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                        <Setter Property="BorderThickness" Value="4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border
                                Width="48"
                                Height="48"
                                Background="{StaticResource Primary500Brush}"
                                CornerRadius="8" />
                            <TextBlock
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding DefaultLabel}" />
                        </StackPanel>
                    </Button>

                    <Button
                        Width="360"
                        Height="188"
                        Margin="6"
                        Command="{Binding SelectHighContrastCommand}">
                        <Button.Style>
                    <Style BasedOn="{StaticResource OutlinedActionSecondaryButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighContrastSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                        <Setter Property="BorderThickness" Value="4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border
                                Width="48"
                                Height="48"
                                Background="{StaticResource Gray1000Brush}"
                                BorderBrush="{StaticResource Gray0Brush}"
                                BorderThickness="2"
                                CornerRadius="8" />
                            <TextBlock
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding HighContrastLabel}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Button
                    Grid.Row="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource FilledActionPrimaryButtonStyle}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="46"
                        FontWeight="SemiBold"
                        Text="Close"
                        TextAlignment="Center" />
                </Button>

            </Grid>
        </Border>
    </Grid>
</UserControl>
