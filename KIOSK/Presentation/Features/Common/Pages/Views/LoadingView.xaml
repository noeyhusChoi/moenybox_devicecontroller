<UserControl
    x:Class="KIOSK.Presentation.Shell.Top.Main.Pages.Views.LoadingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:KIOSK.Presentation.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    xmlns:local="clr-namespace:KIOSK.Presentation.Shell.Top.Main.Pages.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:KIOSK.Presentation.Shell.Top.Main.Pages.ViewModels"
    d:DesignHeight="980"
    d:DesignWidth="1920"
    mc:Ignorable="d">

    <Grid Background="#1F2EF8">
        <controls:VideoPlayerControl
            x:Name="VideoPlayer"
            Width="800"
            Height="588"
            AutoPlay="True"
            Loop="True"
            SourcePath="{Binding VideoPath}" />
    </Grid>
</UserControl>
