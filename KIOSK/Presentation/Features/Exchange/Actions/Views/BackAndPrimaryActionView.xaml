<UserControl
    x:Class="Kiosk.Views.Actions.BackAndPrimaryActionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <Grid
        Width="936"
        Height="120"
        VerticalAlignment="Top"
        behavior:FocusContainer.Mode="HorizontalStack"
        Focusable="False"
        KeyboardNavigation.IsTabStop="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="12*" />
        </Grid.ColumnDefinitions>
        <Button
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Command="{Binding BackCommand}"
            Content="{Binding BackText}"
            IsEnabled="{Binding IsBackEnabled}"
                Style="{StaticResource OutlinedActionSecondaryButtonStyle}" />
        <Button
            Grid.Column="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Command="{Binding PrimaryCommand}"
            Content="{Binding PrimaryText}"
            IsEnabled="{Binding IsPrimaryEnabled}"
                Style="{StaticResource FilledActionPrimaryButtonStyle}" />
    </Grid>
</UserControl>
