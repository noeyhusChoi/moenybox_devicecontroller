<UserControl
    x:Class="Kiosk.Views.ExchangeProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ProgressCircleStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ProgressPendingBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ProgressCurrentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ProgressCurrentBrush}" />
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressNumberStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Text" Value="{Binding NumberText}" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ProgressCurrentForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressCheckIconStyle" TargetType="Path">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Data" Value="M 2,8 L 7,13 L 18,2" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource ProgressCurrentBrush}" />
            <Setter Property="StrokeThickness" Value="6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressLineStyle" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Background" Value="{DynamicResource ProgressCurrentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid
        Height="190"
        VerticalAlignment="Top"
        Background="{DynamicResource ProgressBackgroundBrush}">
        <Rectangle
            Height="4"
            Margin="0,48,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Fill="{DynamicResource ProgressPendingBrush}" />

        <ItemsControl ItemsSource="{Binding}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Width="215">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="103" />
                            <RowDefinition Height="80" />
                            <RowDefinition Height="7" />
                        </Grid.RowDefinitions>

                        <Border
                            Width="68"
                            Height="68"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="34"
                            Style="{StaticResource ProgressCircleStyle}">
                            <Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="34"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource ProgressNumberStyle}" />
                                <Path
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ProgressCheckIconStyle}" />
                            </Grid>
                        </Border>

                        <TextBlock
                            Grid.Row="1"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextTertiaryBrush}"
                            Text="{Binding Label}" />

                        <Border
                            Grid.Row="2"
                            VerticalAlignment="Stretch"
                            Style="{StaticResource ProgressLineStyle}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
