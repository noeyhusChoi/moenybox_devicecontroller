<UserControl
    x:Class="Kiosk.Views.ExchangeProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:Kiosk.Application.Services.Resx"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ProgressCircleBaseStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ProgressPendingBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="ProgressCircleStep1Style" TargetType="Border" BasedOn="{StaticResource ProgressCircleBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource ProgressCurrentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="2">
                    <Setter Property="Background" Value="{DynamicResource CardPrimaryBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ProgressCurrentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="3">
                    <Setter Property="Background" Value="{DynamicResource CardPrimaryBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ProgressCurrentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="4">
                    <Setter Property="Background" Value="{DynamicResource CardPrimaryBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ProgressCurrentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressCircleStep2Style" TargetType="Border" BasedOn="{StaticResource ProgressCircleBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="2">
                    <Setter Property="Background" Value="{DynamicResource ProgressCurrentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="3">
                    <Setter Property="Background" Value="{DynamicResource CardPrimaryBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ProgressCurrentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="4">
                    <Setter Property="Background" Value="{DynamicResource CardPrimaryBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ProgressCurrentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressCircleStep3Style" TargetType="Border" BasedOn="{StaticResource ProgressCircleBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="3">
                    <Setter Property="Background" Value="{DynamicResource ProgressCurrentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="4">
                    <Setter Property="Background" Value="{DynamicResource CardPrimaryBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ProgressCurrentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressCircleStep4Style" TargetType="Border" BasedOn="{StaticResource ProgressCircleBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="4">
                    <Setter Property="Background" Value="{DynamicResource ProgressCurrentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressNumberBaseStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Visibility" Value="Visible" />
        </Style>

        <Style x:Key="ProgressNumberStep1Style" TargetType="TextBlock" BasedOn="{StaticResource ProgressNumberBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="1">
                    <Setter Property="Foreground" Value="{DynamicResource ProgressCurrentForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="2">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="3">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="4">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressNumberStep2Style" TargetType="TextBlock" BasedOn="{StaticResource ProgressNumberBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="2">
                    <Setter Property="Foreground" Value="{DynamicResource ProgressCurrentForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="3">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="4">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressNumberStep3Style" TargetType="TextBlock" BasedOn="{StaticResource ProgressNumberBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="3">
                    <Setter Property="Foreground" Value="{DynamicResource ProgressCurrentForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="4">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressNumberStep4Style" TargetType="TextBlock" BasedOn="{StaticResource ProgressNumberBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="4">
                    <Setter Property="Foreground" Value="{DynamicResource ProgressCurrentForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressCheckIconBaseStyle" TargetType="Path">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Data" Value="M 2,8 L 7,13 L 18,2" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource ProgressCurrentBrush}" />
            <Setter Property="StrokeThickness" Value="6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="ProgressCheckIconStep1Style" TargetType="Path" BasedOn="{StaticResource ProgressCheckIconBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="2">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="3">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="4">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressCheckIconStep2Style" TargetType="Path" BasedOn="{StaticResource ProgressCheckIconBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="3">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="4">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressCheckIconStep3Style" TargetType="Path" BasedOn="{StaticResource ProgressCheckIconBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="4">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressLabelBaseStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="ProgressLabelStep1Style" TargetType="TextBlock" BasedOn="{StaticResource ProgressLabelBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="1">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressLabelStep2Style" TargetType="TextBlock" BasedOn="{StaticResource ProgressLabelBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="2">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressLabelStep3Style" TargetType="TextBlock" BasedOn="{StaticResource ProgressLabelBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="3">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressLabelStep4Style" TargetType="TextBlock" BasedOn="{StaticResource ProgressLabelBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="4">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressLineBaseStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Hidden" />
        </Style>

        <Style x:Key="ProgressLineStep1Style" TargetType="Border" BasedOn="{StaticResource ProgressLineBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="1">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Background" Value="{DynamicResource ProgressCurrentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressLineStep2Style" TargetType="Border" BasedOn="{StaticResource ProgressLineBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="2">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Background" Value="{DynamicResource ProgressCurrentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressLineStep3Style" TargetType="Border" BasedOn="{StaticResource ProgressLineBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="3">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Background" Value="{DynamicResource ProgressCurrentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressLineStep4Style" TargetType="Border" BasedOn="{StaticResource ProgressLineBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="4">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Background" Value="{DynamicResource ProgressCurrentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid
        Height="190"
        VerticalAlignment="Top"
        Background="{DynamicResource ProgressBackgroundBrush}">
        <Rectangle
            Height="4"
            Margin="0,48,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Fill="{DynamicResource ProgressPendingBrush}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="215" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="103" />
                    <RowDefinition Height="80" />
                    <RowDefinition Height="7" />
                </Grid.RowDefinitions>

                <Border
                    Width="68"
                    Height="68"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="34"
                    Style="{StaticResource ProgressCircleStep1Style}">
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="34"
                            FontWeight="SemiBold"
                            Style="{StaticResource ProgressNumberStep1Style}"
                            Text="1" />
                        <Path
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource ProgressCheckIconStep1Style}" />
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource ProgressLabelStep1Style}"
                    Text="{resx:ResxLoc ExchangeSellProcess.SelectCurrency}" />

                <Border
                    Grid.Row="2"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource ProgressLineStep1Style}" />
            </Grid>

            <Grid Grid.Column="1" Width="215" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="103" />
                    <RowDefinition Height="80" />
                    <RowDefinition Height="7" />
                </Grid.RowDefinitions>

                <Border
                    Width="68"
                    Height="68"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="34"
                    Style="{StaticResource ProgressCircleStep2Style}">
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="34"
                            FontWeight="SemiBold"
                            Style="{StaticResource ProgressNumberStep2Style}"
                            Text="2" />
                        <Path
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource ProgressCheckIconStep2Style}" />
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource ProgressLabelStep2Style}"
                    Text="{resx:ResxLoc ExchangeSellProcess.IDScan}" />

                <Border
                    Grid.Row="2"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource ProgressLineStep2Style}" />
            </Grid>

            <Grid Grid.Column="2" Width="215" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="103" />
                    <RowDefinition Height="80" />
                    <RowDefinition Height="7" />
                </Grid.RowDefinitions>

                <Border
                    Width="68"
                    Height="68"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="34"
                    Style="{StaticResource ProgressCircleStep3Style}">
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="34"
                            FontWeight="SemiBold"
                            Style="{StaticResource ProgressNumberStep3Style}"
                            Text="3" />
                        <Path
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource ProgressCheckIconStep3Style}" />
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource ProgressLabelStep3Style}"
                    Text="{resx:ResxLoc ExchangeSellProcess.Deposit}" />

                <Border
                    Grid.Row="2"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource ProgressLineStep3Style}" />
            </Grid>

            <Grid Grid.Column="3" Width="215" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="103" />
                    <RowDefinition Height="80" />
                    <RowDefinition Height="7" />
                </Grid.RowDefinitions>

                <Border
                    Width="68"
                    Height="68"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="34"
                    Style="{StaticResource ProgressCircleStep4Style}">
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="34"
                            FontWeight="SemiBold"
                            Style="{StaticResource ProgressNumberStep4Style}"
                            Text="4" />
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource ProgressLabelStep4Style}"
                    Text="{resx:ResxLoc ExchangeSellProcess.Withdraw}" />

                <Border
                    Grid.Row="2"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource ProgressLineStep4Style}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
