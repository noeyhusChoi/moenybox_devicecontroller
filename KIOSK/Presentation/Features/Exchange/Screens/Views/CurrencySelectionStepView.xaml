<UserControl
    x:Class="Kiosk.Views.Steps.CurrencySelectionStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="72" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="{Binding Title}" />

        <ItemsControl
            x:Name="CurrencyOptionContainer"
            Grid.Row="2"
            behavior:FocusBoundary.DownTarget="{Binding ElementName=PreviousActionButton}"
            Focusable="False"
            ItemsSource="{Binding Options}"
            KeyboardNavigation.DirectionalNavigation="None"
            KeyboardNavigation.IsTabStop="False">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Margin="-12">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid
                        behavior:FocusContainer.InitialFocus="True"
                        behavior:FocusContainer.Mode="UniformGrid"
                        Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button
                        Margin="12"
                        Command="{Binding SelectCommand}"
                        Cursor="Hand"
                        Style="{StaticResource FilledWhiteButtonStyle}">
                        <Grid
                            Margin="0,24"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Ellipse
                                Grid.Row="0"
                                Width="70"
                                Height="70"
                                Stroke="LightGray">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AssetPath}" Stretch="Fill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock
                                Grid.Row="2"
                                HorizontalAlignment="Center"
                                FontSize="40"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource OnDefaultPrimaryBrush}"
                                Text="{Binding Code}" />
                            <TextBlock
                                Grid.Row="3"
                                HorizontalAlignment="Center"
                                FontSize="34"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource OnDefaultSecondaryBrush}"
                                Text="{Binding RateText}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button
            x:Name="PreviousActionButton"
            Grid.Row="3"
            Width="336"
            Height="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            behavior:FocusBoundary.UpTarget="{Binding ElementName=CurrencyOptionContainer}"
            Command="{Binding SecondaryCommand}"
            Content="{Binding SecondaryText}"
            IsEnabled="{Binding IsSecondaryEnabled}"
            Style="{StaticResource OutlinedActionSecondaryButtonStyle}" />
    </Grid>
</UserControl>
