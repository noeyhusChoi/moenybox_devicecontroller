<UserControl
    x:Class="Kiosk.Views.Steps.CurrencySelectionStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="{Binding Title}" />

        <ItemsControl
            Grid.Row="2"
            Focusable="False"
            ItemsSource="{Binding Options}"
            KeyboardNavigation.DirectionalNavigation="None"
            KeyboardNavigation.IsTabStop="False">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Margin="-12">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid
                        behavior:FocusContainer.InitialFocus="True"
                        behavior:FocusContainer.Mode="UniformGrid"
                        Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button
                        Margin="12"
                        BorderBrush="Transparent"
                        Command="{Binding SelectCommand}"
                        Cursor="Hand"
                        Style="{StaticResource FilledWhiteButtonStyle}">
                        <Grid
                            Margin="0,24"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="0"
                                Width="70"
                                Height="70"
                                VerticalAlignment="Top"
                                BorderBrush="LightGray"
                                BorderThickness="1"
                                ClipToBounds="True"
                                CornerRadius="32">
                                <Image Source="{Binding AssetPath}" Stretch="Fill" />
                            </Border>
                            <TextBlock
                                Grid.Row="2"
                                HorizontalAlignment="Center"
                                FontSize="40"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource OnDefaultPrimaryBrush}"
                                Text="{Binding Code}" />
                            <TextBlock
                                Grid.Row="3"
                                HorizontalAlignment="Center"
                                FontSize="34"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource OnDefaultSecondaryBrush}"
                                Text="{Binding RateText}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid
            Grid.Row="3"
            Width="936"
            Height="170"
            VerticalAlignment="Top"
            behavior:FocusContainer.Mode="HorizontalStack"
            Focusable="False"
            KeyboardNavigation.IsTabStop="False">
            <Button
                Width="336"
                Height="120"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Command="{Binding SecondaryCommand}"
                Content="{Binding SecondaryText}"
                IsEnabled="{Binding IsSecondaryEnabled}"
                Style="{StaticResource OutlinedActionSecondaryButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
