<UserControl
    x:Class="Kiosk.Views.Steps.DispenseFailureStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:stepVm="clr-namespace:Kiosk.ViewModels.Steps"
    d:DataContext="{d:DesignInstance Type=stepVm:DispenseFailureStepViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="1235"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ResultTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="59" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="224" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="{Binding Title}" />

        <Grid Grid.Row="1" Width="936" VerticalAlignment="Top">
            <StackPanel Margin="0,80,0,0">
            <Grid
                Width="120"
                Height="120"
                HorizontalAlignment="Center">
                <Ellipse Fill="#E65100" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border
                        Width="14"
                        Height="46"
                        Background="White"
                        CornerRadius="7" />
                    <Ellipse
                        Width="14"
                        Height="14"
                        Margin="0,8,0,0"
                        Fill="White" />
                </StackPanel>
            </Grid>

            <TextBlock
                Margin="0,32,0,0"
                Style="{StaticResource ResultTitleStyle}"
                Text="{Binding Headline}" />

            <Border
                Margin="0,48,0,0"
                Padding="54"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="32">
                <StackPanel>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Border
                            Padding="16,16,24,16"
                            BorderBrush="{DynamicResource SurfaceMutedBackgroundBrush}"
                            BorderThickness="3"
                            CornerRadius="40">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="50" Height="50">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding SourceFlagImagePath}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="34"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="{Binding SourceCurrencyCode}" />
                            </StackPanel>
                        </Border>
                        <Separator Width="16" Background="Transparent" />

                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="11"
                                Height="11"
                                Margin="0,0,16,0"
                                Fill="{DynamicResource AccentBackgroundBrush}" />
                            <Ellipse
                                Width="11"
                                Height="11"
                                Margin="0,0,16,0"
                                Fill="{DynamicResource AccentBackgroundBrush}" />
                            <Ellipse
                                Width="11"
                                Height="11"
                                Margin="0,0,16,0"
                                Fill="{DynamicResource AccentBackgroundBrush}" />
                            <Polygon
                                Height="20"
                                Fill="{DynamicResource AccentBackgroundBrush}"
                                Points="0,20 0,0 16,10" />
                        </StackPanel>
                        <Separator Width="16" Background="Transparent" />
                        <Border
                            Padding="16,16,24,16"
                            BorderBrush="{DynamicResource SurfaceMutedBackgroundBrush}"
                            BorderThickness="3"
                            CornerRadius="40">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="50" Height="50">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding TargetFlagImagePath}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="34"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="{Binding TargetCurrencyCode}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,40,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="88" />
                            <RowDefinition Height="88" />
                            <RowDefinition Height="88" />
                        </Grid.RowDefinitions>

                        <DockPanel
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            LastChildFill="True">
                            <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="입금 금액" />
                            <TextBlock Style="{StaticResource SummaryValueStyle}" Text="{Binding DepositAmountText, StringFormat={}{0} USD}" />
                        </DockPanel>

                        <Border
                            Grid.Row="1"
                            Height="2"
                            VerticalAlignment="Top"
                            Background="{DynamicResource FeatureDividerBrush}" />
                        <DockPanel
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            LastChildFill="True">
                            <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="지급 금액" />
                            <TextBlock Style="{StaticResource SummaryValueStyle}" Text="{Binding DispensedAmountText, StringFormat={}{0} KRW}" />
                        </DockPanel>

                        <Border
                            Grid.Row="2"
                            Height="2"
                            VerticalAlignment="Top"
                            Background="{DynamicResource FeatureDividerBrush}" />

                        <DockPanel
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            LastChildFill="True">
                            <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="지급되지 않은 금액" />
                            <TextBlock
                                Foreground="{DynamicResource PrimaryBrush}"
                                Style="{StaticResource SummaryValueStyle}"
                                Text="{Binding UndispensedAmountText, StringFormat={}{0} KRW}" />
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,24,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Padding="54"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="32,32,0,0">
                    <StackPanel>
                        <TextBlock
                            FontSize="34"
                            FontWeight="Medium"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{Binding ErrorMessage}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <Border
                            Margin="0,40,0,0"
                            Background="{DynamicResource SurfaceMutedBackgroundBrush}"
                            CornerRadius="24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="88" />
                                    <RowDefinition Height="88" />
                                </Grid.RowDefinitions>

                                <DockPanel
                                    Grid.Row="0"
                                    Margin="40,0"
                                    VerticalAlignment="Center"
                                    LastChildFill="True">
                                    <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="고객센터" />
                                    <TextBlock Style="{StaticResource SummaryValueStyle}" Text="02-757-0000" />
                                </DockPanel>

                                <Border
                                    Grid.Row="1"
                                    Height="2"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource FeatureDividerBrush}" />

                                <DockPanel
                                    Grid.Row="1"
                                    Margin="40,0"
                                    VerticalAlignment="Center"
                                    LastChildFill="True">
                                    <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="관리지점" />
                                    <TextBlock Style="{StaticResource SummaryValueStyle}" Text="머니박스 명동지점" />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Rectangle
                    Grid.Row="1"
                    Height="2"
                    Fill="{DynamicResource FeatureDividerBrush}" />
                <Border
                    Grid.Row="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="0,0,32,32">
                    <DockPanel
                        Margin="0,32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        LastChildFill="False">
                        <TextBlock
                            FontSize="34"
                            FontWeight="Medium"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="관리지점 정보 자세히 보기" />
                        <TextBlock
                            Margin="0,-2,0,0"
                            FontSize="34"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="›" />
                    </DockPanel>
                </Border>
            </Grid>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
