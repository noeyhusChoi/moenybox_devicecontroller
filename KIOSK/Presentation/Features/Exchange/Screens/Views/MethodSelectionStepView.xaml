<UserControl
    x:Class="Kiosk.Views.Steps.MethodSelectionStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="MethodOptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="53" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="200" />
            <RowDefinition Height="592" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            HorizontalAlignment="Center"
            FontSize="59"
            FontWeight="Bold"
            Text="{Binding Title}" />

        <Grid
            Grid.Row="2"
            VerticalAlignment="Stretch"
            behavior:FocusContainer.InitialFocus="True"
            behavior:FocusContainer.Mode="HorizontalStack"
            Focusable="False"
            KeyboardNavigation.DirectionalNavigation="Continue"
            KeyboardNavigation.IsTabStop="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="452" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="452" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Command="{Binding SelectPrepaidCardCommand}"
                Style="{StaticResource FilledWhiteButtonStyle}">
                <Grid VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="64" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image
                        Grid.Row="0"
                        Width="180"
                        Height="180"
                        Source="pack://application:,,,/Assets/Image/img_card.png"
                        Stretch="Uniform" />

                    <TextBlock Grid.Row="2" Style="{StaticResource MethodOptionTextStyle}">
                        <Run Text="선불카드로" />
                        <LineBreak />
                        <Run Text="환전" />
                    </TextBlock>
                </Grid>
            </Button>

            <Button
                Grid.Column="2"
                Command="{Binding SelectCashCommand}"
                Style="{StaticResource FilledWhiteButtonStyle}">
                <Grid VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="64" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image
                        Grid.Row="0"
                        Width="180"
                        Height="180"
                        Source="pack://application:,,,/Assets/Image/img_bill.png"
                        Stretch="Uniform" />

                    <TextBlock Grid.Row="2" Style="{StaticResource MethodOptionTextStyle}">
                        <Run Text="지폐로" />
                        <LineBreak />
                        <Run Text="환전" />
                    </TextBlock>
                </Grid>
            </Button>
        </Grid>

        <Grid
            Grid.Row="3"
            Height="170"
            VerticalAlignment="Top"
            behavior:FocusContainer.Mode="HorizontalStack"
            Focusable="False"
            KeyboardNavigation.IsTabStop="False">
            <Button
                Width="336"
                Height="120"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Command="{Binding SecondaryCommand}"
                Content="{Binding SecondaryText}"
                IsEnabled="{Binding IsSecondaryEnabled}"
                Style="{StaticResource OutlinedActionSecondaryButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
