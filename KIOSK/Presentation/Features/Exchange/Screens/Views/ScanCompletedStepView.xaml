<UserControl
    x:Class="Kiosk.Views.Steps.ScanCompletedStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ResultHeadlineStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="59" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ResultDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ResultNoticeStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource AccentEmphasisForegroundBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ErrorDetailStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSuccess}" Value="False" />
                        <Condition Binding="{Binding HasErrorDetail}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessVisualStyle" TargetType="Image">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FailureVisualStyle" TargetType="Image">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="SuccessNoticeVisibilityStyle"
            BasedOn="{StaticResource ResultNoticeStyle}"
            TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Focusable="False" KeyboardNavigation.IsTabStop="False">
        <StackPanel Margin="0,208,0,0" HorizontalAlignment="Center">
            <Image
                Width="360"
                Height="360"
                HorizontalAlignment="Center"
                Source="pack://application:,,,/Assets/Image/img_scan_success.png"
                Stretch="Uniform"
                Style="{StaticResource SuccessVisualStyle}" />

            <Image
                Width="360"
                Height="360"
                HorizontalAlignment="Center"
                Source="pack://application:,,,/Assets/Image/img_scan_fail.png"
                Stretch="Uniform"
                Style="{StaticResource FailureVisualStyle}" />

            <TextBlock
                Margin="0,78,0,0"
                Style="{StaticResource ResultHeadlineStyle}"
                Text="{Binding Headline}" />
            <TextBlock
                Margin="0,24,0,0"
                Style="{StaticResource ResultDescriptionStyle}"
                Text="{Binding Description}" />
            <TextBlock
                Margin="0,24,0,0"
                Style="{StaticResource SuccessNoticeVisibilityStyle}"
                Text="{Binding NoticeText}" />
            <TextBlock
                Margin="0,20,0,0"
                Style="{StaticResource ErrorDetailStyle}"
                Text="{Binding ErrorDetailText}" />
        </StackPanel>
    </Grid>
</UserControl>
