<UserControl
    x:Class="KIOSK.Presentation.Features.ExchangeV2.Pages.Views.ExchangeV2ExchangeMethodSelectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KIOSK.Presentation.Features.ExchangeV2.Pages.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1920"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource Pretendard}"
            FontSize="{StaticResource FontSize_3XL}"
            FontWeight="{StaticResource FontWeight_L}"
            Foreground="{StaticResource WhiteBrush}"
            Text="환전 방법을 선택해주세요" />
        <StackPanel Grid.Row="1">
            <Button
                Height="300"
                Margin="10"
                Command="{Binding NextCommand}"
                CommandParameter="SELL">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="{StaticResource Pretendard}"
                                    FontSize="{StaticResource FontSize_4XL}"
                                    FontWeight="{StaticResource FontWeight_L}"
                                    Foreground="{StaticResource BlackBrush}"
                                    Text="선불 카드로 환전" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button
                Height="300"
                Margin="10"
                Command="{Binding NextCommand}"
                CommandParameter="SELL">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="{StaticResource Pretendard}"
                                    FontSize="{StaticResource FontSize_4XL}"
                                    FontWeight="{StaticResource FontWeight_L}"
                                    Foreground="{StaticResource BlackBrush}"
                                    Text="지폐로 환전" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
        <Button
            Grid.Row="2"
            Height="100"
            Margin="10"
            Command="{Binding PreviousCommand}"
            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
            Content="이전"
            FontFamily="{StaticResource Pretendard}"
            FontSize="{StaticResource FontSize_XL}"
            FontWeight="{StaticResource FontWeight_M}"
            Foreground="{StaticResource BlackBrush}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
