<UserControl
    x:Class="KIOSK.Presentation.Features.ExchangeV2.Pages.Views.ExchangeV2IdScanCompleteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KIOSK.Presentation.Features.ExchangeV2.Pages.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1920"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <Grid Margin="10" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image
            Grid.Row="0"
            Width="256"
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Source="/Assets/Image/succss.png" />
        <TextBlock
            Grid.Row="1"
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource Pretendard}"
            FontSize="{StaticResource FontSize_3XL}"
            FontWeight="{StaticResource FontWeight_L}"
            Foreground="{StaticResource WhiteBrush}"
            Text="신분증 스캔을 성공적으로 마쳤습니다" />

        <TextBlock
            Grid.Row="2"
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource Pretendard}"
            FontSize="{StaticResource FontSize_L}"
            FontWeight="{StaticResource FontWeight_M}"
            Foreground="{StaticResource WhiteBrush}"
            Text="신분증 및 여권의 분실 방지를 위해 반드시 회수하신 후 다음 스텝을 진행해주세요" />

        <TextBlock
            Grid.Row="3"
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource Pretendard}"
            FontSize="{StaticResource FontSize_L}"
            FontWeight="{StaticResource FontWeight_M}"
            Foreground="{StaticResource WhiteBrush}"
            Opacity="0.7"
            Text="분실에 대한 책임은 당사가 지지 않습니다" />

        <Border
            Grid.Row="4"
            Margin="20,10,20,0"
            Padding="20"
            Background="#22000000"
            CornerRadius="10">
            <StackPanel>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Foreground="WhiteSmoke"
                    Text="{Binding IdType, StringFormat=ID Type: {0}}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Foreground="WhiteSmoke"
                    Text="{Binding CustomerName, StringFormat=Name: {0}}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Foreground="WhiteSmoke"
                    Text="{Binding CustomerNumber, StringFormat=Number: {0}}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Foreground="WhiteSmoke"
                    Text="{Binding CustomerNationality, StringFormat=Nationality: {0}}" />
            </StackPanel>
        </Border>

        <UniformGrid
            Grid.Row="5"
            VerticalAlignment="Bottom"
            Columns="2">
            <Button
                Height="100"
                Margin="10"
                Command="{Binding PreviousCommand}"
                CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                Content="이전(Debug)"
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{StaticResource BlackBrush}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button
                Height="100"
                Margin="10"
                Command="{Binding NextCommand}"
                CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                Content="다음(Debug)"
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{StaticResource BlackBrush}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
