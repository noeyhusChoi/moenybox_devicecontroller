<UserControl
    x:Class="KIOSK.Presentation.Features.ExchangeV2.Pages.Views.ExchangeV2IdScanProcessView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:KIOSK.Presentation.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KIOSK.Presentation.Features.ExchangeV2.Pages.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1920"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource Pretendard}"
            FontSize="{StaticResource FontSize_3XL}"
            FontWeight="{StaticResource FontWeight_L}"
            Foreground="{StaticResource WhiteBrush}"
            Text="신분증 스캔을 진행해주세요" />

        <controls:VideoPlayerControl
            Grid.Row="1"
            Width="800"
            Margin="0,12,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutoPlay="True"
            Loop="True"
            SourcePath="{Binding VideoPath}" />

        <UniformGrid
            Grid.Row="2"
            Width="800"
            Columns="2">
            <Image
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="/Assets/Image/IDScan_Passport.png" />
            <Image
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="/Assets/Image/IDScan_ID.png" />
        </UniformGrid>

        <TextBlock
            Grid.Row="3"
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource Pretendard}"
            FontSize="{StaticResource FontSize_XL}"
            FontWeight="{StaticResource FontWeight_M}"
            Foreground="{StaticResource WhiteBrush}"
            Text="얼굴 사진이 있는 정보면을 아래로하여 스캐너에 올려주세요" />

        <UniformGrid
            Grid.Row="3"
            VerticalAlignment="Bottom"
            Columns="2">
            <Button
                Height="100"
                Margin="10"
                Command="{Binding PreviousCommand}"
                Content="이전(Debug)"
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{StaticResource BlackBrush}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button
                Height="100"
                Margin="10"
                Command="{Binding NextCommand}"
                Content="다음(Debug)"
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{StaticResource BlackBrush}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>

