<UserControl
    x:Class="KIOSK.Presentation.Features.ExchangeV2.Popup.Views.ExchangeV2IdScanFailedPopupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="700"
    Height="420"
    mc:Ignorable="d">
    <Border
        Background="White"
        BorderBrush="Gray"
        BorderThickness="1"
        CornerRadius="30"
        SnapsToDevicePixels="True">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource Pretendard}"
                    FontSize="{StaticResource FontSize_XL}"
                    FontWeight="{StaticResource FontWeight_M}"
                    Text="{Binding Title}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource Pretendard}"
                    FontSize="{StaticResource FontSize_L}"
                    Foreground="Gray"
                    Text="{Binding Message}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Button
                Grid.Row="1"
                Height="90"
                Margin="0,20,0,0"
                Command="{Binding ConfirmCommand}"
                Content="확인"
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_M}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
