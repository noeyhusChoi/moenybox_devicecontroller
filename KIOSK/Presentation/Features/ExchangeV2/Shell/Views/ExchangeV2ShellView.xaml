<UserControl
    x:Class="KIOSK.Presentation.Features.ExchangeV2.Shell.Views.ExchangeV2ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:exchangeV2Views="clr-namespace:KIOSK.Presentation.Features.ExchangeV2.Shell.Views"
    xmlns:local="clr-namespace:KIOSK.Presentation.Features.ExchangeV2.Shell.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1920"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <exchangeV2Views:ExchangeV2FlowHeaderView Grid.Row="0" DataContext="{Binding FlowHeader}">
            <exchangeV2Views:ExchangeV2FlowHeaderView.Style>
                <Style TargetType="exchangeV2Views:ExchangeV2FlowHeaderView">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </exchangeV2Views:ExchangeV2FlowHeaderView.Style>
        </exchangeV2Views:ExchangeV2FlowHeaderView>

        <!--  Default Layer  -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />

        <!--  Dim Background + Popup Layer  -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PopupContent}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="#80000000" />
            <ContentPresenter Content="{Binding PopupContent}" />
        </Grid>
    </Grid>
</UserControl>
