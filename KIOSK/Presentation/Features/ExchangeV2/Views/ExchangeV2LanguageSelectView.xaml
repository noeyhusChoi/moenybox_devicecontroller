<UserControl
    x:Class="KIOSK.Presentation.Features.ExchangeV2.Views.ExchangeV2LanguageSelectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KIOSK.Presentation.Features.ExchangeV2.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1920"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Image
            Grid.Row="0"
            Margin="20"
            Source="/Assets/Image/Common_Logo.png" />
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_4XL}"
                FontWeight="{StaticResource FontWeight_L}"
                Foreground="{StaticResource WhiteBrush}"
                Text="Travel Easy"
                TextAlignment="Center" />
            <TextBlock
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_4XL}"
                FontWeight="{StaticResource FontWeight_L}"
                Foreground="{StaticResource WhiteBrush}"
                Text="Exchange Smart"
                TextAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
            <TextBlock
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_2XL}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{StaticResource WhiteBrush}"
                Text="Select your language to begin"
                TextAlignment="Center" />
            <TextBlock
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{StaticResource WhiteBrush}"
                Text="언어를 선택하시고 서비스를 시작해 보세요"
                TextAlignment="Center" />
        </StackPanel>
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Width="200"
                Height="200"
                Command="{Binding NextCommand}"
                CommandParameter="ko"
                Content="English"
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{StaticResource BlackBrush}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button
                Width="200"
                Height="200"
                Margin="10,0,0,0"
                Command="{Binding NextCommand}"
                CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                Content="中文(简体)"
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{StaticResource BlackBrush}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button
                Width="200"
                Height="200"
                Margin="10,0,0,0"
                Command="{Binding NextCommand}"
                CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                Content="中文(繁体)"
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{StaticResource BlackBrush}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button
                Width="200"
                Height="200"
                Margin="10,0,0,0"
                Command="{Binding NextCommand}"
                CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                Content="日本語"
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{StaticResource BlackBrush}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button
                Width="200"
                Height="200"
                Margin="10,0,0,0"
                Command="{Binding NextCommand}"
                CommandParameter="ko"
                Content="한국어"
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{StaticResource BlackBrush}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
        <Button
            Grid.Row="4"
            Height="100"
            Margin="20"
            Command="{Binding PreviousCommand}"
            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
            Content="이전"
            FontFamily="{StaticResource Pretendard}"
            FontSize="{StaticResource FontSize_XL}"
            FontWeight="{StaticResource FontWeight_M}"
            Foreground="{StaticResource BlackBrush}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
