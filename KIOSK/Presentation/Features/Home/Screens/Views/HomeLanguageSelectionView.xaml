<UserControl
    x:Class="Kiosk.Views.HomeLanguageSelectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    behavior:FocusBoundary.EntryTarget="{Binding ElementName=LanguageItemsControl}"
    d:DesignHeight="1705"
    d:DesignWidth="1080"
    d:Language="ko-KR"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="LanguageTileLabelTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="39" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="72" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="190" />
            <RowDefinition Height="160" />
            <RowDefinition Height="124" />
            <RowDefinition Height="996" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                FontSize="59"
                FontWeight="Bold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="언어를 선택해주세요"
                TextAlignment="Center" />
            <TextBlock
                Margin="0,21,0,0"
                FontSize="40"
                FontWeight="Medium"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="Please select your language"
                TextAlignment="Center" />
        </StackPanel>

        <ItemsControl
            x:Name="LanguageItemsControl"
            Grid.Row="3"
            Width="936"
            Height="996"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            ItemsSource="{Binding VisibleLanguageOptions}"
            KeyboardNavigation.DirectionalNavigation="Continue"
            KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Margin="-16">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <primitives:UniformGrid
                        behavior:FocusContainer.InitialFocus="True"
                        behavior:FocusContainer.Mode="UniformGrid"
                        Columns="2"
                        Rows="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button
                        Margin="16"
                        behavior:FocusContainer.IsPreferredFocus="{Binding IsSelected}"
                        Command="{Binding SelectCommand}"
                        Cursor="Hand"
                        Style="{StaticResource FilledWhiteButtonStyle}">
                        <Grid
                            Margin="0,30"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="0"
                                Width="100"
                                Height="100"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                ClipToBounds="True"
                                CornerRadius="50">
                                <Image Source="{Binding AssetPath}" Stretch="Fill" />
                            </Border>
                            <TextBlock
                                Grid.Row="2"
                                Margin="0"
                                FontFamily="{StaticResource AppFont}"
                                FontWeight="{StaticResource FontWeight_M}"
                                Style="{StaticResource LanguageTileLabelTextStyle}"
                                Text="{Binding Label}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
