<UserControl
    x:Class="KIOSK.Presentation.Features.MenuV2.Views.MenuV2View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KIOSK.Presentation.Features.MenuV2.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1920"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock
                Margin="0,0,0,100"
                HorizontalAlignment="Center"
                FontFamily="{StaticResource Pretendard}"
                FontSize="{StaticResource FontSize_3XL}"
                FontWeight="{StaticResource FontWeight_L}"
                Foreground="{StaticResource WhiteBrush}"
                Text="원하시는 서비스를 선택해 주세요." />
            <WrapPanel
                MaxWidth="1600"
                HorizontalAlignment="Center"
                ItemHeight="300"
                ItemWidth="800">
                <WrapPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Width" Value="780" />
                        <Setter Property="Height" Value="280" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </WrapPanel.Resources>
                <Button
                    Command="{Binding NextCommand}"
                    CommandParameter="CARD"
                    IsEnabled="{Binding IsActiveExchangeSell}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Padding="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="30">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top">
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_3XL}"
                                            FontWeight="{StaticResource FontWeight_L}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Text="PREPAID CARD"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_XL}"
                                            FontWeight="{StaticResource FontWeight_M}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Opacity="0.7"
                                            Text="간체"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_XL}"
                                            FontWeight="{StaticResource FontWeight_M}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Opacity="0.7"
                                            Text="번체"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_XL}"
                                            FontWeight="{StaticResource FontWeight_M}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Opacity="0.7"
                                            Text="일본어"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_XL}"
                                            FontWeight="{StaticResource FontWeight_M}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Opacity="0.7"
                                            Text="한국어"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Command="{Binding NextCommand}" CommandParameter="EXCHANGE">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Padding="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="30">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top">
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_3XL}"
                                            FontWeight="{StaticResource FontWeight_L}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Text="CURRENCY EXCHANGE"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_XL}"
                                            FontWeight="{StaticResource FontWeight_M}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Opacity="0.7"
                                            Text="간체"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_XL}"
                                            FontWeight="{StaticResource FontWeight_M}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Opacity="0.7"
                                            Text="번체"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_XL}"
                                            FontWeight="{StaticResource FontWeight_M}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Opacity="0.7"
                                            Text="일본어"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_XL}"
                                            FontWeight="{StaticResource FontWeight_M}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Opacity="0.7"
                                            Text="한국어"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Command="{Binding NextCommand}" CommandParameter="TAXFREE">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Padding="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="30">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top">
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_3XL}"
                                            FontWeight="{StaticResource FontWeight_L}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Text="TAX FREE"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_XL}"
                                            FontWeight="{StaticResource FontWeight_M}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Opacity="0.7"
                                            Text="간체"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_XL}"
                                            FontWeight="{StaticResource FontWeight_M}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Opacity="0.7"
                                            Text="번체"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_XL}"
                                            FontWeight="{StaticResource FontWeight_M}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Opacity="0.7"
                                            Text="일본어"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            FontFamily="{StaticResource Pretendard}"
                                            FontSize="{StaticResource FontSize_XL}"
                                            FontWeight="{StaticResource FontWeight_M}"
                                            Foreground="{StaticResource BlackBrush}"
                                            Opacity="0.7"
                                            Text="한국어"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </WrapPanel>
        </StackPanel>

    </Grid>
</UserControl>
