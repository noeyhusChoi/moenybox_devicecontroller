<UserControl
    x:Class="KIOSK.Presentation.Features.Startup.Pages.Views.StartupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:KIOSK.Presentation.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KIOSK.Presentation.Features.Startup.Pages.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1920"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <Grid Background="#1F2EF8">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="13*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource Pretendard}"
            FontSize="{StaticResource FontSize_L}"
            FontWeight="{StaticResource FontWeight_M}"
            Foreground="{StaticResource WhiteBrush}"
            Text="{Binding Message}" />

        <controls:LottiePlayerControl
            Grid.Row="1"
            Width="800"
            Height="688"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutoPlay="True"
            SourcePath="{Binding LottieSourcePath}" />
    </Grid>
</UserControl>
