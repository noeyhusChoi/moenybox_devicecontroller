<UserControl
    x:Class="Kiosk.Views.ButtonStyleGalleryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="2600"
    d:DesignWidth="2080"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{DynamicResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="48,48,48,24">
                <TextBlock
                    FontSize="44"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="Button Style Gallery" />
                <TextBlock
                    Margin="0,12,0,0"
                    FontSize="22"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="Shared button style preview page" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Margin="48,0,48,24"
                Padding="32"
                Style="{StaticResource CardSurfaceBorderStyle}">
                <StackPanel>
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Action Buttons" />
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="20"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Bottom action button examples" />

                    <Grid Margin="0,28,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="336" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="576" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Height="123"
                            Content="Back"
                    Style="{StaticResource OutlinedActionSecondaryButtonStyle}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Height="123"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="Next"
                    Style="{StaticResource FilledActionPrimaryButtonStyle}" />

                        <Button
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Height="123"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="Print Receipt"
                    Style="{StaticResource FilledActionPrimaryButtonStyle}" />

                        <Button
                            Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Height="123"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="Next (Disabled)"
                            IsEnabled="False"
                    Style="{StaticResource FilledActionPrimaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Grid.Row="2"
                Margin="48,0,48,24"
                Padding="32"
                Style="{StaticResource CardSurfaceBorderStyle}">
                <StackPanel>
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Filled Buttons" />
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="20"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Filled button variants in use" />

                    <Grid Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="452" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="452" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="452" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Style="{StaticResource FilledWhiteButtonStyle}">
                            <Grid Margin="80,52">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="53"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource OnDefaultPrimaryBrush}"
                                    Text="Filled White" />
                            </Grid>
                        </Button>

                        <Button
                            Grid.Column="2"
                            Style="{StaticResource FilledPrimaryButtonStyle}">
                            <Grid Margin="80,52">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="53"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource OnAccentPrimaryBrush}"
                                    Text="Filled Featured" />
                            </Grid>
                        </Button>

                        <Button
                            Grid.Column="4"
                            Style="{StaticResource FilledDarkButtonStyle}">
                            <Grid Margin="80,52">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="53"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource OnStrongPrimaryBrush}"
                                    Text="Filled Dark" />
                            </Grid>
                        </Button>
                    </Grid>

                    <Button
                        Width="452"
                        Margin="0,32,0,0"
                        Style="{StaticResource FilledActionPrimaryButtonStyle}">
                        <Grid Margin="80,52">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="53"
                                FontWeight="Bold"
                            Foreground="{DynamicResource OnActionPrimaryPrimaryBrush}"
                                Text="Filled Action" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <Border
                Grid.Row="3"
                Margin="48,0,48,48"
                Padding="32"
                Style="{StaticResource CardSurfaceBorderStyle}">
                <StackPanel>
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Outline / Link" />
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="20"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Outline button and text link examples" />

                    <StackPanel Margin="0,28,0,0">
                        <Button
                            Width="220"
                            Height="123"
                            Content="Outlined Button"
                    Style="{StaticResource OutlinedActionSecondaryButtonStyle}" />
                        <Button
                            Width="220"
                            Margin="0,24,0,0"
                            Content="View Terms"
                            Style="{StaticResource FocusablePlainLinkButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
