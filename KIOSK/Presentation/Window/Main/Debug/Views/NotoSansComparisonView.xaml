<UserControl
    x:Class="Kiosk.Views.NotoSansComparisonView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1920"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{StaticResource Gray200Brush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="48,48,48,24">
                <TextBlock
                    FontSize="44"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Gray1000Brush}"
                    Text="Noto Sans SC / TC Comparison" />
                <TextBlock
                    Margin="0,12,0,0"
                    FontSize="22"
                    Foreground="{StaticResource Gray1000Brush}"
                    Text="디자이너에서 간체(SC)와 번체(TC) 폰트 차이만 확인하는 비교 화면" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Margin="48,0,48,24"
                Padding="32"
                Background="{StaticResource Gray0Brush}"
                CornerRadius="24">
                <StackPanel>
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Gray1000Brush}"
                        Text="Same Text / Different Family" />
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="20"
                        Foreground="{StaticResource Gray1000Brush}"
                        Text="같은 문자열을 NotoSansSC와 NotoSansTC에 직접 적용해서 비교" />

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Column="1"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Gray1000Brush}"
                            Text="NotoSansSC" />
                        <TextBlock
                            Grid.Column="2"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Gray1000Brush}"
                            Text="NotoSansTC" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,20,0,0"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="繁體中文" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,20,0,0"
                            FontFamily="{StaticResource Noto Sans SC}"
                            FontSize="32"
                            FontWeight="Normal"
                            Foreground="{StaticResource Gray1000Brush}"
                            Text="繁體中文" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,20,0,0"
                            FontFamily="{StaticResource Noto Sans TC}"
                            FontSize="32"
                            FontWeight="Normal"
                            Foreground="{StaticResource Gray1000Brush}"
                            Text="繁體中文" />

                        <TextBlock
                            Grid.Row="2"
                            Margin="0,20,0,0"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="简体中文" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,20,0,0"
                            FontFamily="{StaticResource Noto Sans SC}"
                            FontSize="32"
                            FontWeight="Normal"
                            Foreground="{StaticResource Primary500Brush}"
                            Text="简体中文" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="0,20,0,0"
                            FontFamily="{StaticResource Noto Sans TC}"
                            FontSize="32"
                            FontWeight="Normal"
                            Foreground="{StaticResource Primary500Brush}"
                            Text="简体中文" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Grid.Row="2"
                Margin="48,0,48,48"
                Padding="32"
                Background="{StaticResource Gray0Brush}"
                CornerRadius="24">
                <StackPanel>
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Gray1000Brush}"
                        Text="Weight Check" />
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="20"
                        Foreground="{StaticResource Gray1000Brush}"
                        Text="Regular / Medium / SemiBold / Bold를 SC와 TC 각각 직접 비교" />

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Column="1"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Gray1000Brush}"
                            Text="Regular" />
                        <TextBlock
                            Grid.Column="2"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Gray1000Brush}"
                            Text="Medium" />
                        <TextBlock
                            Grid.Column="3"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Gray1000Brush}"
                            Text="SemiBold" />
                        <TextBlock
                            Grid.Column="4"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Gray1000Brush}"
                            Text="Bold" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,20,0,0"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="SC" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,20,0,0"
                            FontFamily="{StaticResource Noto Sans SC}"
                            FontSize="28"
                            FontWeight="Normal"
                            Text="简体中文測試 123" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,20,0,0"
                            FontFamily="{StaticResource Noto Sans SC}"
                            FontSize="28"
                            FontWeight="Medium"
                            Text="简体中文測試 123" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="3"
                            Margin="0,20,0,0"
                            FontFamily="{StaticResource Noto Sans SC}"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="简体中文測試 123" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="4"
                            Margin="0,20,0,0"
                            FontFamily="{StaticResource Noto Sans SC}"
                            FontSize="28"
                            FontWeight="Bold"
                            Text="简体中文測試 123" />

                        <TextBlock
                            Grid.Row="2"
                            Margin="0,20,0,0"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="TC" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,20,0,0"
                            FontFamily="{StaticResource Noto Sans TC}"
                            FontSize="28"
                            FontWeight="Normal"
                            Text="繁體中文測試 123" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="0,20,0,0"
                            FontFamily="{StaticResource Noto Sans TC}"
                            FontSize="28"
                            FontWeight="Medium"
                            Text="繁體中文測試 123" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="3"
                            Margin="0,20,0,0"
                            FontFamily="{StaticResource Noto Sans TC}"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="繁體中文測試 123" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="4"
                            Margin="0,20,0,0"
                            FontFamily="{StaticResource Noto Sans TC}"
                            FontSize="28"
                            FontWeight="Bold"
                            Text="繁體中文測試 123" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
