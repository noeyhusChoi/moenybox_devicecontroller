<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource Gray0}" />
    <SolidColorBrush x:Key="FeatureBackgroundBrush" Color="#FFF6F0" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource Gray0}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F7D8C4" />
    <SolidColorBrush x:Key="SurfaceMutedBackgroundBrush" Color="#FBE5D8" />
    <SolidColorBrush x:Key="AccentSurfaceBackgroundBrush" Color="#FFF0E6" />
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#F47D31" />
    <SolidColorBrush x:Key="AccentStrongBackgroundBrush" Color="#A9551F" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Gray1000}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource Gray0}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#F47D31" />
    <SolidColorBrush x:Key="AccentEmphasisForegroundBrush" Color="#A9551F" />

    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#E7BCA1" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource Gray1000}" />
    <SolidColorBrush x:Key="BorderAccentBrush" Color="#F47D31" />
    <SolidColorBrush x:Key="SelectionMarkerBrush" Color="{StaticResource Gray1000}" />
    <SolidColorBrush x:Key="FeatureDividerBrush" Color="#FDE3D1" />

    <SolidColorBrush
        x:Key="OverlayDimBrush"
        Opacity="0.4"
        Color="{StaticResource Black}" />
</ResourceDictionary>
