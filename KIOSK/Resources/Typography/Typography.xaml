<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--<FontFamily x:Key="Pretendard">/kiosk;component/Assets/Fonts/#Pretendard Variable</FontFamily>-->

    <FontFamily x:Key="Noto Sans">/Kiosk;component/Assets/Fonts/NotoSans/CompositeFont/NotoSans.CompositeFont#Noto Sans</FontFamily>
    <FontFamily x:Key="Noto Sans KR">/Kiosk;component/Assets/Fonts/NotoSans/CompositeFont/NotoSansKR.CompositeFont#Noto Sans KR</FontFamily>
    <FontFamily x:Key="Noto Sans JP">/Kiosk;component/Assets/Fonts/NotoSans/CompositeFont/NotoSansJP.CompositeFont#Noto Sans JP</FontFamily>
    <FontFamily x:Key="Noto Sans SC">/Kiosk;component/Assets/Fonts/NotoSans/CompositeFont/NotoSansSC.CompositeFont#Noto Sans SC</FontFamily>
    <FontFamily x:Key="Noto Sans TC">/Kiosk;component/Assets/Fonts/NotoSans/CompositeFont/NotoSansTC.CompositeFont#Noto Sans TC</FontFamily>

    <!--  ========== 폰트 사이즈 토큰 ==========  -->
    <sys:Double x:Key="FontSize_2XS">22</sys:Double>
    <sys:Double x:Key="FontSize_XS">24</sys:Double>
    <sys:Double x:Key="FontSize_S">28</sys:Double>
    <sys:Double x:Key="FontSize_M">30</sys:Double>
    <sys:Double x:Key="FontSize_L">32</sys:Double>
    <sys:Double x:Key="FontSize_XL">40</sys:Double>
    <sys:Double x:Key="FontSize_2XL">48</sys:Double>
    <sys:Double x:Key="FontSize_3XL">52</sys:Double>
    <sys:Double x:Key="FontSize_4XL">80</sys:Double>

    <FontWeight x:Key="FontWeight_S">Regular</FontWeight>
    <FontWeight x:Key="FontWeight_M">Medium</FontWeight>
    <FontWeight x:Key="FontWeight_L">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeight_XL">Bold</FontWeight>

    <Style x:Key="ExchangeStepTitleStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="60" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
