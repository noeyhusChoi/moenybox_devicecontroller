<UserControl
    x:Class="Kiosk.Views.ExchangeProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ProgressCircleStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBackgroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressNumberStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Text" Value="{Binding NumberText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter Property="Text" Value="✓" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgressLineStyle" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Background" Value="{DynamicResource AccentBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Height="205" Background="{DynamicResource AppBackgroundBrush}">
        <Rectangle
            Width="760"
            Height="4"
            Margin="152,48,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Fill="{DynamicResource SurfaceMutedBackgroundBrush}" />

        <ItemsControl ItemsSource="{Binding}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Width="216">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100" />
                            <RowDefinition Height="98" />
                            <RowDefinition Height="7" />
                        </Grid.RowDefinitions>

                        <Border
                            Width="68"
                            Height="68"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="34"
                            Style="{StaticResource ProgressCircleStyle}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="34"
                                FontWeight="SemiBold"
                                Style="{StaticResource ProgressNumberStyle}" />
                        </Border>

                        <TextBlock
                            Grid.Row="1"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextTertiaryBrush}"
                            Text="{Binding Label}" />

                        <Border
                            Grid.Row="2"
                            VerticalAlignment="Stretch"
                            Style="{StaticResource ProgressLineStyle}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
