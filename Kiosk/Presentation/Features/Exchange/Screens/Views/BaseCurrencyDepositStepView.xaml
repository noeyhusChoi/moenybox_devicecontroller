<UserControl
    x:Class="Kiosk.Views.Steps.BaseCurrencyDepositStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="LimitLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize_XS}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_M}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LimitValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize_XS}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_L}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="72" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Margin="0,-70,0,0"
            Padding="16,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="10"
            Background="{DynamicResource DebugPanelBackgroundBrush}"
            Opacity="0.4">
            <TextBlock
                MaxWidth="320"
                FontSize="{StaticResource FontSize_XS}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap" />
        </Border>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="{Binding Title}" />

        <Border Grid.Row="2" Style="{StaticResource CardSurfaceBorderStyle}">
            <Grid Margin="54">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="410" />
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="True">
                    <TextBlock
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Style="{StaticResource LimitLabelStyle}"
                        Text="입금가능 권종" />
                    <ItemsControl HorizontalAlignment="Right" ItemsSource="{Binding AcceptedDenominationImagePaths}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    FlowDirection="LeftToRight"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,-30,0">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="16"
                                            Direction="200"
                                            Opacity="0.20"
                                            ShadowDepth="8"
                                            Color="#000000" />
                                    </Border.Effect>
                                    <Image
                                        Width="132"
                                        Height="56"
                                        Source="{Binding}"
                                        Stretch="Fill" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="{DynamicResource AppBackgroundBrush}"
                        CornerRadius="32">
                        <Image Source="{Binding GuideImagePath}" Stretch="Uniform" />
                    </Border>

                    <Border
                        Grid.Column="2"
                        Background="{DynamicResource AppBackgroundBrush}"
                        CornerRadius="32">
                        <StackPanel Margin="40,0" VerticalAlignment="Center">
                            <Border
                                Width="54"
                                Height="54"
                                HorizontalAlignment="Left">
                                <Image Source="{Binding SourceFlagPath, Mode=OneWay}" Stretch="Fill" />
                            </Border>
                            <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run
                                    FontSize="{StaticResource FontSize_M}"
                                    FontWeight="{StaticResource FontWeight_L}"
                                    Text="{Binding DepositAmountText, Mode=OneWay}" />
                                <Run FontSize="{StaticResource FontSize_M}" Text=" " />
                                <Run
                                    FontSize="{StaticResource FontSize_XS}"
                                    FontWeight="{StaticResource FontWeight_L}"
                                    Text="{Binding SourceCurrencyCode, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardSurfaceBorderStyle}">
            <ItemsControl ItemsSource="{Binding BaseCurrencyInfoRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="110">
                            <Border
                                Margin="54,0"
                                VerticalAlignment="Top"
                                Background="{DynamicResource FeatureDividerDefaultBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Height" Value="2" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTopDivider}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Grid Margin="54,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LimitLabelStyle}"
                                    Text="{Binding Label}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LimitValueStyle}" Text="{Binding AmountText}" />
                                    <TextBlock Style="{StaticResource LimitValueStyle}" Text=" KRW" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid
            x:Name="DepositActionContainer"
            Grid.Row="5"
            Height="120"
            VerticalAlignment="Bottom"
            behavior:FocusBoundary.EntryTarget="{Binding ElementName=DepositActionContainer}"
            behavior:FocusContainer.InitialFocus="True"
            behavior:FocusContainer.Mode="HorizontalStack"
            Focusable="False"
            KeyboardNavigation.IsTabStop="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="12*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Command="{Binding SecondaryCommand}"
                IsEnabled="{Binding IsSecondaryEnabled}"
                Style="{StaticResource OutlinedActionSecondaryButtonStyle}">
                <TextBlock Text="이전" />
            </Button>
            <Button
                Grid.Column="2"
                Command="{Binding PrimaryCommand}"
                IsEnabled="{Binding IsPrimaryEnabled}"
                Style="{StaticResource FilledActionPrimaryButtonStyle}">
                <TextBlock Text="다음" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
