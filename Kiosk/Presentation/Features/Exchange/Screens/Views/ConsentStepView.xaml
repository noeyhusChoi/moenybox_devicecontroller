<UserControl
    x:Class="Kiosk.Views.Steps.ConsentStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Kiosk"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ConsentLinkButtonStyle" BasedOn="{StaticResource PlainLinkButtonStyle}" TargetType="Button">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsKeyboardFocused}" Value="True" />
                        <Condition Binding="{Binding Source={x:Static local:KeyboardNavigationState.Instance}, Path=IsEnabled}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="224" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="{Binding Title}" />

        <Grid Grid.Row="1" Width="936" Height="1100" Focusable="False" KeyboardNavigation.IsTabStop="False" KeyboardNavigation.DirectionalNavigation="Continue">
            <Grid.RowDefinitions>
                <RowDefinition Height="352" />
                <RowDefinition Height="40" />
                <RowDefinition Height="83" />
                <RowDefinition Height="106" />
                <RowDefinition Height="255" />
                <RowDefinition Height="93" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Image
                Width="660"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="pack://application:,,,/Assets/Image/Passport.png"
                Stretch="Uniform" />


        <Border
            Grid.Row="2"
            HorizontalAlignment="Center"
            Background="{DynamicResource AccentSurfaceBackgroundBrush}"
            CornerRadius="41.5">
            <TextBlock
                Margin="40,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="34"
                FontWeight="SemiBold"
                Foreground="{DynamicResource AccentEmphasisForegroundBrush}"
                Text="{Binding SupportedDocumentTypes}" />
        </Border>

        <Border
            Grid.Row="4"
            Width="936"
            Height="255"
            Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="140" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Height="60"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox
                        Grid.Column="0"
                        Width="60"
                        Height="60"
                        FocusVisualStyle="{x:Null}"
                        IsChecked="{Binding IsAgreed, Mode=TwoWay}">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border
                                    x:Name="CheckBorder"
                                    Width="60"
                                    Height="60"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="3"
                                    CornerRadius="16">
                                    <Path
                                        x:Name="Tick"
                                        Width="30"
                                        Height="22"
                                        Data="M 2,12 L 10,20 L 28,2"
                                        Stroke="{DynamicResource AccentBackgroundBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="4"
                                        Visibility="Collapsed" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentBackgroundBrush}" />
                                        <Setter TargetName="CheckBorder" Property="BorderThickness" Value="0" />
                                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Tick" Property="Stroke" Value="{DynamicResource TextOnAccentBrush}" />
                                    </Trigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsKeyboardFocused}" Value="True" />
                                            <Condition Binding="{Binding Source={x:Static local:KeyboardNavigationState.Instance}, Path=IsEnabled}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                        <Setter TargetName="CheckBorder" Property="BorderThickness" Value="5" />
                                    </MultiDataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="40"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding TermsTitle}" />
                </Grid>

                <Rectangle
                    Grid.Row="1"
                    Height="2"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource FeatureDividerBrush}" />
                <Button
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding ViewTermsCommand}"
                    Cursor="Hand"
                    Style="{StaticResource ConsentLinkButtonStyle}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            FontSize="34"
                            FontWeight="Medium"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{Binding TermsLinkText}" />
                        <TextBlock
                            FontSize="34"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="›" />
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

            <TextBlock
                Grid.Row="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="34"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{Binding Body}" />
        </Grid>
    </Grid>
</UserControl>
