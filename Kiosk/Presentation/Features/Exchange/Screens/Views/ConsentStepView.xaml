<UserControl
    x:Class="Kiosk.Views.Steps.ConsentStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Kiosk"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="신분증을 준비해 주세요" />

        <Grid
            x:Name="ConsentContentContainer"
            Grid.Row="2"
            behavior:FocusBoundary.DownTarget="{Binding ElementName=ConsentActionContainer}"
            Focusable="False"
            KeyboardNavigation.DirectionalNavigation="Continue"
            KeyboardNavigation.IsTabStop="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="352" />
                <RowDefinition Height="72" />
                <RowDefinition Height="88" />
                <RowDefinition Height="72" />
                <RowDefinition Height="257" />
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image
                Width="660"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="pack://application:,,,/Assets/Image/Passport.png"
                Stretch="Uniform" />

            <Border
                Grid.Row="2"
                HorizontalAlignment="Center"
                BorderBrush="{DynamicResource Gray200Brush}"
                BorderThickness="2"
                CornerRadius="41.5">
                <TextBlock
                    Margin="40,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="34"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextAccentStrongBrush}"
                    Text="여권, 주민등록증, 운전면허증, 외국인등록증" />
            </Border>

            <Border
                Grid.Row="4"
                Width="936"
                Height="255"
                Style="{StaticResource CardSurfaceBorderStyle}">
                <Grid
                    behavior:FocusContainer.InitialFocus="True"
                    behavior:FocusContainer.Mode="VerticalStack"
                    Focusable="False"
                    KeyboardNavigation.DirectionalNavigation="Continue"
                    KeyboardNavigation.IsTabStop="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="140" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <CheckBox
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        behavior:FocusContainer.IsPreferredFocus="True"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        Focusable="{Binding Source={x:Static local:KeyboardNavigationState.Instance}, Path=IsEnabled}"
                        IsChecked="{Binding IsAgreed, Mode=TwoWay}"
                        IsTabStop="{Binding Source={x:Static local:KeyboardNavigationState.Instance}, Path=IsEnabled}"
                        KeyboardNavigation.IsTabStop="{Binding Source={x:Static local:KeyboardNavigationState.Instance}, Path=IsEnabled}">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            x:Name="CheckFocusRing"
                                            Grid.Column="0"
                                            Width="72"
                                            Height="72"
                                            Margin="-6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource CheckboxFocusRingBrush}"
                                            BorderThickness="4"
                                            CornerRadius="22"
                                            Visibility="Collapsed" />

                                        <Border
                                            x:Name="CheckBorder"
                                            Grid.Column="0"
                                            Width="60"
                                            Height="60"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource CheckboxBackgroundBrush}"
                                            BorderBrush="{DynamicResource CheckboxBorderBrush}"
                                            BorderThickness="3"
                                            CornerRadius="16">
                                            <Path
                                                x:Name="Tick"
                                                Width="30"
                                                Height="22"
                                                Data="M 2,12 L 10,20 L 28,2"
                                                Stroke="{DynamicResource CheckboxCheckmarkBrush}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeThickness="4"
                                                Visibility="Collapsed" />
                                        </Border>

                                        <ContentPresenter
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource CheckboxCheckedBackgroundBrush}" />
                                        <Setter TargetName="CheckBorder" Property="BorderThickness" Value="0" />
                                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Tick" Property="Stroke" Value="{DynamicResource CheckboxCheckmarkBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="CheckFocusRing" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource CheckboxFocusRingBrush}" />
                                        <Setter TargetName="CheckBorder" Property="BorderThickness" Value="4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="40"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="개인정보 수집 이용 및 제3자 제공 동의" />
                    </CheckBox>

                    <Rectangle
                        Grid.Row="1"
                        Height="2"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource FeatureDividerDefaultBrush}" />

                    <Button
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{Binding ViewTermsCommand}"
                        Cursor="Hand"
                        Focusable="{Binding Source={x:Static local:KeyboardNavigationState.Instance}, Path=IsEnabled}"
                        IsTabStop="{Binding Source={x:Static local:KeyboardNavigationState.Instance}, Path=IsEnabled}"
                        KeyboardNavigation.IsTabStop="{Binding Source={x:Static local:KeyboardNavigationState.Instance}, Path=IsEnabled}"
                        Style="{StaticResource FocusablePlainLinkButtonStyle}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="34"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="이용약관 보기" />
                            <TextBlock
                                FontSize="34"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="›" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TextBlock
                Grid.Row="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="34"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="이용약관에 동의하셔야 다음 단계로 이동이 가능합니다." />

            <Grid
                x:Name="ConsentActionContainer"
                Grid.Row="7"
                Height="120"
                VerticalAlignment="Bottom"
                behavior:FocusBoundary.UpTarget="{Binding ElementName=ConsentContentContainer}"
                behavior:FocusContainer.Mode="HorizontalStack"
                Focusable="False"
                KeyboardNavigation.IsTabStop="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="12*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Command="{Binding SecondaryCommand}"
                    Content="이전"
                    IsEnabled="{Binding IsSecondaryEnabled}"
                    Style="{StaticResource OutlinedActionSecondaryButtonStyle}" />

                <Button
                    Grid.Column="2"
                    Command="{Binding PrimaryCommand}"
                    Content="다음"
                    IsEnabled="{Binding IsPrimaryEnabled}"
                    Style="{StaticResource FilledActionPrimaryButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
