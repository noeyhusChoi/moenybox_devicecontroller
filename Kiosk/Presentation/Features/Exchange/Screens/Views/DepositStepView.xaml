<UserControl
    x:Class="Kiosk.Views.Steps.DepositStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="LimitLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#555A65" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LimitValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="224" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="{Binding Title}" />

        <Grid Grid.Row="1" Width="936" Height="1020">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Padding="16,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                Background="#EDEFF5"
                CornerRadius="16">
                <TextBlock
                    MaxWidth="320"
                    FontSize="24"
                    FontWeight="Medium"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap" />
            </Border>

        <Border
            Grid.Row="0"
            Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="32">
            <Grid Margin="54">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="80" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="410" />
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="True">
                    <TextBlock
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Style="{StaticResource LimitLabelStyle}"
                        Text="입금가능 권종" />
                    <ItemsControl HorizontalAlignment="Right" ItemsSource="{Binding AcceptedDenominationImagePaths}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    FlowDirection="RightToLeft"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,-30,0">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="16"
                                            Direction="200"
                                            Opacity="0.20"
                                            ShadowDepth="8"
                                            Color="#000000" />
                                    </Border.Effect>
                                    <Image
                                        Width="132"
                                        Height="56"
                                        Source="{Binding}"
                                        Stretch="Fill" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <Border
                    Grid.Row="1"
                    Height="2"
                    Background="{DynamicResource FeatureDividerBrush}" />

                <DockPanel Grid.Row="2" LastChildFill="True">
                    <TextBlock
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Style="{StaticResource LimitLabelStyle}"
                        Text="환율" />
                    <TextBlock Style="{StaticResource LimitValueStyle}">
                        <Run Text="{Binding ExchangeRateText, Mode=OneWay}" />
                        <Run Text=" " />
                        <Run Text="{Binding TargetCurrencyCode, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="{DynamicResource SurfaceMutedBackgroundBrush}"
                        CornerRadius="32">
                        <Image Source="{Binding GuideImagePath}" Stretch="Uniform" />
                    </Border>

                    <Border
                        Grid.Column="2"
                        Padding="32"
                        Background="{DynamicResource SurfaceMutedBackgroundBrush}"
                        CornerRadius="32">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="34"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="입금" />
                                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run
                                        FontSize="50"
                                        FontWeight="Bold"
                                        Text="{Binding DepositAmountText, Mode=OneWay}" />
                                    <Run FontSize="48" Text=" " />
                                    <Run
                                        FontSize="34"
                                        FontWeight="SemiBold"
                                        Text="{Binding SourceCurrencyCode, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <Border
                                Grid.Row="1"
                                Height="2"
                                Margin="0,16"
                                Background="{DynamicResource FeatureDividerBrush}" />

                            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="34"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="환전" />
                                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource AccentBackgroundBrush}">
                                    <Run
                                        FontSize="50"
                                        FontWeight="Bold"
                                        Text="{Binding ExchangeAmountText, Mode=OneWay}" />
                                    <Run FontSize="48" Text=" " />
                                    <Run
                                        FontSize="34"
                                        FontWeight="SemiBold"
                                        Text="{Binding TargetCurrencyCode, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

            <Border
                Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="32">
                <StackPanel Margin="54,36">
                    <DockPanel LastChildFill="True">
                        <TextBlock Style="{StaticResource LimitLabelStyle}" Text="1일 최대 환전한도" />
                        <TextBlock Grid.Column="1" Style="{StaticResource LimitValueStyle}">
                            <Run Text="{Binding DailyMaximumAmountText, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding SourceCurrencyCode, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>

                    <Border
                        Height="2"
                        Margin="0,16"
                        Background="{DynamicResource FeatureDividerBrush}" />

                    <DockPanel LastChildFill="True">
                        <TextBlock Style="{StaticResource LimitLabelStyle}" Text="잔여 1일 환전한도" />
                        <TextBlock Grid.Column="1" Style="{StaticResource LimitValueStyle}">
                            <Run Text="{Binding DailyRemainingMaximumAmountText, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding SourceCurrencyCode, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>

                    <Border
                        Height="2"
                        Margin="0,16"
                        Background="{DynamicResource FeatureDividerBrush}" />

                    <DockPanel LastChildFill="True">
                        <TextBlock Style="{StaticResource LimitLabelStyle}" Text="1일 최대 환전 가능 금액" />
                        <TextBlock Grid.Column="1" Style="{StaticResource LimitValueStyle}">
                            <Run Text="{Binding DailyAvailableExchangeAmountText, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding SourceCurrencyCode, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
