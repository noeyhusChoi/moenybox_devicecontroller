<UserControl
    x:Class="Kiosk.Views.Steps.DispenseFailureStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:stepVm="clr-namespace:Kiosk.ViewModels.Steps"
    xmlns:svg="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
    d:DataContext="{d:DesignInstance Type=stepVm:DispenseFailureStepViewModel,
                                     IsDesignTimeCreatable=True}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ResultTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="59" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <svg:SvgIcon
            Grid.Row="0"
            Width="120"
            Height="120"
            HorizontalAlignment="Center"
            AppName="KIOSK"
            Fill="{DynamicResource StatusSuccessBackgroundBrush}"
            Stroke="{DynamicResource StatusSuccessForegroundBrush}"
            UriSource="pack://application:,,,/KIOSK;component/Assets/Icon/ico.svg" />

        <TextBlock
            Grid.Row="2"
            Style="{StaticResource ResultTitleStyle}"
            Text="{Binding Headline}" />

        <Border
            Grid.Row="4"
            Padding="54"
            Style="{StaticResource CardSurfaceBorderStyle}">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Padding="16,16,24,16"
                        BorderBrush="{DynamicResource CardSecondaryBorderBrush}"
                        BorderThickness="3"
                        CornerRadius="40">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="50" Height="50">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding SourceFlagImagePath}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="34"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding SourceCurrencyCode}" />
                        </StackPanel>
                    </Border>
                    <Separator Width="16" Background="Transparent" />

                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="11"
                            Height="11"
                            Margin="0,0,16,0"
                            Fill="{DynamicResource AccentBackgroundBrush}" />
                        <Ellipse
                            Width="11"
                            Height="11"
                            Margin="0,0,16,0"
                            Fill="{DynamicResource AccentBackgroundBrush}" />
                        <Ellipse
                            Width="11"
                            Height="11"
                            Margin="0,0,16,0"
                            Fill="{DynamicResource AccentBackgroundBrush}" />
                        <Polygon
                            Height="20"
                            Fill="{DynamicResource AccentBackgroundBrush}"
                            Points="0,20 0,0 16,10" />
                    </StackPanel>
                    <Separator Width="16" Background="Transparent" />
                    <Border
                        Padding="16,16,24,16"
                        BorderBrush="{DynamicResource CardSecondaryBorderBrush}"
                        BorderThickness="3"
                        CornerRadius="40">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="50" Height="50">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding TargetFlagImagePath}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="34"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding TargetCurrencyCode}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Margin="0,40,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88" />
                        <RowDefinition Height="88" />
                        <RowDefinition Height="88" />
                    </Grid.RowDefinitions>

                    <DockPanel
                        Grid.Row="0"
                        VerticalAlignment="Center"
                        LastChildFill="True">
                        <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="입금 금액" />
                        <TextBlock Style="{StaticResource SummaryValueStyle}" Text="{Binding DepositAmountText, StringFormat={}{0} USD}" />
                    </DockPanel>

                    <Border
                        Grid.Row="1"
                        Height="2"
                        VerticalAlignment="Top"
                        Background="{DynamicResource FeatureDividerDefaultBrush}" />
                    <DockPanel
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        LastChildFill="True">
                        <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="지급 금액" />
                        <TextBlock Style="{StaticResource SummaryValueStyle}" Text="{Binding DispensedAmountText, StringFormat={}{0} KRW}" />
                    </DockPanel>

                    <Border
                        Grid.Row="2"
                        Height="2"
                        VerticalAlignment="Top"
                        Background="{DynamicResource FeatureDividerDefaultBrush}" />

                    <DockPanel
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        LastChildFill="True">
                        <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="지급되지 않은 금액" />
                        <TextBlock
                            Foreground="{DynamicResource TextAccentBrush}"
                            Style="{StaticResource SummaryValueStyle}"
                            Text="{Binding UndispensedAmountText, StringFormat={}{0} KRW}" />
                    </DockPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource CardSurfaceBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="54">
                    <TextBlock
                        FontSize="34"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding ErrorMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border
                        Margin="0,40,0,0"
                        Background="{DynamicResource AppBackgroundBrush}"
                        CornerRadius="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="88" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="88" />
                            </Grid.RowDefinitions>

                            <DockPanel
                                Grid.Row="0"
                                Margin="40,0"
                                VerticalAlignment="Center"
                                LastChildFill="True">
                                <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="고객센터" />
                                <TextBlock Style="{StaticResource SummaryValueStyle}" Text="02-757-0000" />
                            </DockPanel>

                            <Border
                                Grid.Row="1"
                                Height="10"
                                VerticalAlignment="Top"
                                Background="{DynamicResource FeatureDividerDefaultBrush}" />

                            <DockPanel
                                Grid.Row="2"
                                Margin="40,0"
                                VerticalAlignment="Center"
                                LastChildFill="True">
                                <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="관리지점" />
                                <TextBlock Style="{StaticResource SummaryValueStyle}" Text="머니박스 명동지점" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <Rectangle
                    Grid.Row="1"
                    Height="4"
                    Fill="{DynamicResource FeatureDividerAccentBrush}" />

                <Border Grid.Row="2">
                    <StackPanel
                        Margin="0,32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            FontSize="34"
                            FontWeight="Medium"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="관리자 정보 자세히 보기" />
                        <svg:SvgIcon
                            Width="24"
                            Height="24"
                            Margin="10,6,0,0"
                            AppName="KIOSK"
                            Fill="{DynamicResource TextSecondaryBrush}"
                            Stroke="{DynamicResource TextSecondaryBrush}"
                            UriSource="pack://application:,,,/KIOSK;component/Assets/Icon/ico_chevron_right.svg" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid
            x:Name="DispenseFailureActionContainer"
            Grid.Row="7"
            Height="120"
            VerticalAlignment="Bottom"
            behavior:FocusBoundary.EntryTarget="{Binding ElementName=DispenseFailurePrimaryButton}"
            behavior:FocusContainer.InitialFocus="True"
            behavior:FocusContainer.Mode="HorizontalStack"
            Focusable="False"
            KeyboardNavigation.IsTabStop="False">
            <Button
                x:Name="DispenseFailurePrimaryButton"
                Command="{Binding PrimaryCommand}"
                Content="영수증 출력"
                IsEnabled="{Binding IsPrimaryEnabled}"
                Style="{StaticResource FilledActionPrimaryButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
