<UserControl
    x:Class="Kiosk.Views.Steps.DispensingStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="224" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="{Binding Title}" />

        <Grid Grid.Row="1" Width="936" Height="1020">
            <Border
                Padding="20,16"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{DynamicResource DebugPanelBackgroundBrush}"
                BorderBrush="{DynamicResource DebugPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="20">
                <StackPanel Width="360">
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="임시 출금 계획" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="18"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding PlanSummary}" />
                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding PlanLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontFamily="Consolas"
                                    FontSize="16"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border
                        Height="1"
                        Margin="0,12,0,12"
                        Background="{DynamicResource FeatureDividerDefaultBrush}" />

                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="장치 요청" />
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding CommandLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontFamily="Consolas"
                                    FontSize="16"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel
                Margin="0,170,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <Grid Width="520" Height="340">
                    <Border
                        Width="300"
                        Height="144"
                        Margin="120,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        CornerRadius="8"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="-1.5" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" />
                        </Border.Effect>
                        <Image Source="{Binding DisplayNoteImagePaths[2], FallbackValue={x:Null}}" Stretch="Fill" />
                    </Border>

                    <Border
                        Width="300"
                        Height="144"
                        Margin="160,110,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        CornerRadius="8"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="0.8" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" />
                        </Border.Effect>
                        <Image Source="{Binding DisplayNoteImagePaths[1], FallbackValue={x:Null}}" Stretch="Fill" />
                    </Border>

                    <Border
                        Width="300"
                        Height="144"
                        Margin="80,180,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        CornerRadius="8"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="0.2" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" />
                        </Border.Effect>
                        <Image Source="{Binding DisplayNoteImagePaths[0], FallbackValue={x:Null}}" Stretch="Fill" />
                    </Border>
                </Grid>

                <TextBlock
                    Margin="0,48,0,0"
                    FontSize="59"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="{Binding PrimaryMessage}"
                    TextAlignment="Center" />

                <TextBlock
                    Margin="0,24,0,0"
                    FontSize="40"
                    FontWeight="Medium"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding SecondaryMessage}"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
