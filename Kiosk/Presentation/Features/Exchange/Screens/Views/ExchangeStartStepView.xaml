<UserControl
    x:Class="Kiosk.Views.Steps.ExchangeStartStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid behavior:FocusContainer.InitialFocus="True" behavior:FocusContainer.Mode="VerticalStack">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="외화를 원화로 환전할 수 있습니다." />


        <Border
            Grid.Row="1"
            Width="600"
            Height="400"
            Margin="52">
            <Image
                Width="300"
                Height="300"
                Source="{Binding ImageAssetPath}"
                Stretch="Uniform" />
        </Border>

        <Button
            x:Name="PrimaryActionButton"
            Grid.Row="2"
            Height="280"
            Command="{Binding StartCommand}"
            Style="{StaticResource FilledPrimaryButtonStyle}"
            Visibility="{Binding ShowStartAction, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="60"
                FontWeight="SemiBold"
                Text="외화 판매 시작하기"
                TextAlignment="Center" />
        </Button>

        <Button
            Grid.Row="3"
            Width="336"
            Height="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Command="{Binding SecondaryCommand}"
            Content="이전"
            IsEnabled="{Binding IsSecondaryEnabled}"
            Style="{StaticResource OutlinedActionSecondaryButtonStyle}"
            Visibility="{Binding HasSecondaryAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>
