<UserControl
    x:Class="Kiosk.Views.Steps.ForeignCurrencyDepositStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="LimitLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize_XS}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_M}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LimitValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize_XS}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_L}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="72" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Margin="0,-70,0,0"
            Padding="16,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="10"
            Background="{DynamicResource DebugPanelBackgroundBrush}"
            Opacity="0.4">
            <TextBlock
                MaxWidth="320"
                FontSize="{StaticResource FontSize_XS}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap" />
        </Border>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="{Binding Title}" />

        <Border Grid.Row="2" Style="{StaticResource CardSurfaceBorderStyle}">
            <Grid Margin="54">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="80" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="410" />
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="True">
                    <TextBlock
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Style="{StaticResource LimitLabelStyle}"
                        Text="입금가능 권종" />
                    <ItemsControl HorizontalAlignment="Right" ItemsSource="{Binding AcceptedDenominationImagePaths}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    FlowDirection="RightToLeft"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,-30,0">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="16"
                                            Direction="200"
                                            Opacity="0.20"
                                            ShadowDepth="8"
                                            Color="#000000" />
                                    </Border.Effect>
                                    <Image
                                        Width="132"
                                        Height="56"
                                        Source="{Binding}"
                                        Stretch="Fill" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <Border
                    Grid.Row="1"
                    Height="2"
                    Background="{DynamicResource FeatureDividerDefaultBrush}" />

                <DockPanel Grid.Row="2" LastChildFill="True">
                    <TextBlock
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Style="{StaticResource LimitLabelStyle}"
                        Text="환율" />
                    <TextBlock Style="{StaticResource LimitValueStyle}">
                        <Run Text="{Binding ExchangeRateText, Mode=OneWay}" />
                        <Run Text=" " />
                        <Run Text="{Binding TargetCurrencyCode, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="{DynamicResource AppBackgroundBrush}"
                        CornerRadius="32">
                        <Image Source="{Binding GuideImagePath}" Stretch="Uniform" />
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Background="{DynamicResource AppBackgroundBrush}"
                            CornerRadius="32">
                            <StackPanel Margin="40,0" VerticalAlignment="Center">
                                <Border
                                    Width="54"
                                    Height="54"
                                    HorizontalAlignment="Left">
                                    <Image Source="{Binding SourceFlagPath, Mode=OneWay}" Stretch="Fill" />
                                </Border>
                                <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run
                                        FontSize="{StaticResource FontSize_M}"
                                        FontWeight="{StaticResource FontWeight_L}"
                                        Text="{Binding DepositAmountText, Mode=OneWay}" />
                                    <Run FontSize="{StaticResource FontSize_M}" Text=" " />
                                    <Run
                                        FontSize="{StaticResource FontSize_XS}"
                                        FontWeight="{StaticResource FontWeight_L}"
                                        Text="{Binding SourceCurrencyCode, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Background="{DynamicResource AppBackgroundBrush}"
                            CornerRadius="32">
                            <StackPanel Margin="40,0" VerticalAlignment="Center">
                                <Border
                                    Width="54"
                                    Height="54"
                                    HorizontalAlignment="Left">
                                    <Image Source="{Binding TargetFlagPath, Mode=OneWay}" Stretch="Fill" />
                                </Border>
                                <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource TextAccentBrush}">
                                    <Run
                                        FontSize="{StaticResource FontSize_M}"
                                        FontWeight="{StaticResource FontWeight_L}"
                                        Text="{Binding ExchangeAmountText, Mode=OneWay}" />
                                    <Run FontSize="{StaticResource FontSize_M}" Text=" " />
                                    <Run
                                        FontSize="{StaticResource FontSize_XS}"
                                        FontWeight="{StaticResource FontWeight_L}"
                                        Text="{Binding TargetCurrencyCode, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Width="66"
                            Height="66"
                            VerticalAlignment="Center"
                            Background="{StaticResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource OnAccentPrimaryBrush}"
                            BorderThickness="6"
                            CornerRadius="33">
                            <svgc:SvgIcon
                                Width="24"
                                Height="24"
                                AppName="KIOSK"
                                Fill="{DynamicResource TextPrimaryBrush}"
                                RenderTransformOrigin="0.5,0.5"
                                Stroke="{DynamicResource TextPrimaryBrush}"
                                UriSource="pack://application:,,,/KIOSK;component/Assets/Icon/ico_chevron_right.svg">
                                <svgc:SvgIcon.RenderTransform>
                                    <RotateTransform Angle="90" />
                                </svgc:SvgIcon.RenderTransform>
                            </svgc:SvgIcon>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardSurfaceBorderStyle}">
            <Grid>
                <StackPanel Margin="54,36">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowExchangeLimitInfo}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <DockPanel LastChildFill="True">
                        <TextBlock Style="{StaticResource LimitLabelStyle}" Text="1일 최대 환전한도" />
                        <TextBlock Grid.Column="1" Style="{StaticResource LimitValueStyle}">
                            <Run Text="{Binding DailyMaximumAmountText, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding SourceCurrencyCode, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>

                    <Border
                        Height="2"
                        Margin="0,16"
                        Background="{DynamicResource FeatureDividerDefaultBrush}" />

                    <DockPanel LastChildFill="True">
                        <TextBlock Style="{StaticResource LimitLabelStyle}" Text="잔여 1일 환전한도" />
                        <TextBlock Grid.Column="1" Style="{StaticResource LimitValueStyle}">
                            <Run Text="{Binding DailyRemainingMaximumAmountText, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding SourceCurrencyCode, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>

                    <Border
                        Height="2"
                        Margin="0,16"
                        Background="{DynamicResource FeatureDividerDefaultBrush}" />

                    <DockPanel LastChildFill="True">
                        <TextBlock Style="{StaticResource LimitLabelStyle}" Text="1회 최대 환전 가능 금액" />
                        <TextBlock Grid.Column="1" Style="{StaticResource LimitValueStyle}">
                            <Run Text="{Binding DailyAvailableExchangeAmountText, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding SourceCurrencyCode, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </StackPanel>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPrepaidChargeInfo}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="109" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="109" />
                    </Grid.RowDefinitions>

                    <Grid Margin="54,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource LimitLabelStyle}"
                            Text="{Binding PrimaryPrepaidInfoLabel}" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LimitValueStyle}" Text="{Binding PrimaryPrepaidInfoAmountText}" />
                            <TextBlock Style="{StaticResource LimitValueStyle}" Text=" KRW" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Margin="54,0"
                        Background="{DynamicResource FeatureDividerDefaultBrush}" />

                    <Button
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{Binding ShowPrepaidLimitInfoCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource FocusablePlainLinkButtonStyle}" TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowPrepaidLimitInfoLink}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="{StaticResource FontSize_XS}"
                                FontWeight="{StaticResource FontWeight_M}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="충전 금액 및 한도 금액 자세히보기" />
                            <svgc:SvgIcon
                                Width="18"
                                Height="18"
                                Margin="8,2,0,0"
                                AppName="KIOSK"
                                Fill="{DynamicResource TextPrimaryBrush}"
                                Stroke="{DynamicResource TextPrimaryBrush}"
                                UriSource="pack://application:,,,/KIOSK;component/Assets/Icon/ico_chevron_right.svg" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid
            x:Name="DepositActionContainer"
            Grid.Row="5"
            Height="120"
            VerticalAlignment="Bottom"
            behavior:FocusBoundary.EntryTarget="{Binding ElementName=DepositActionContainer}"
            behavior:FocusContainer.InitialFocus="True"
            behavior:FocusContainer.Mode="HorizontalStack"
            Focusable="False"
            KeyboardNavigation.IsTabStop="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="12*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Command="{Binding SecondaryCommand}"
                IsEnabled="{Binding IsSecondaryEnabled}"
                Style="{StaticResource OutlinedActionSecondaryButtonStyle}">
                <TextBlock Text="이전" />
            </Button>
            <Button
                Grid.Column="2"
                Command="{Binding PrimaryCommand}"
                IsEnabled="{Binding IsPrimaryEnabled}"
                Style="{StaticResource FilledActionPrimaryButtonStyle}">
                <TextBlock Text="다음" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
