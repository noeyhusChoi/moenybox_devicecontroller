<UserControl
    x:Class="Kiosk.Views.Steps.MessageStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="224" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="{Binding Title}" />

        <Border
            Grid.Row="1"
            Padding="56"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            BorderThickness="1"
            CornerRadius="36">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Width="126"
                    Height="52"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AccentSurfaceBackgroundBrush}"
                    CornerRadius="26">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentForegroundBrush}"
                        Text="안내" />
                </Border>
                <StackPanel
                    Grid.Row="1"
                    Margin="0,42,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Grid Width="144" Height="144">
                        <Ellipse Fill="{DynamicResource AccentBackgroundBrush}" />
                        <Border
                            Width="64"
                            Height="64"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            CornerRadius="32" />
                    </Grid>
                    <TextBlock
                        Margin="0,36,0,0"
                        FontSize="38"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding Body}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
