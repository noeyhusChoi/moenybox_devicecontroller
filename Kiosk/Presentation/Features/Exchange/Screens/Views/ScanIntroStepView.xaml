<UserControl
    x:Class="Kiosk.Views.Steps.ScanIntroStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Kiosk.Presentation.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="224" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="{Binding Title}" />

        <Grid Grid.Row="1" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="710" />
                <RowDefinition Height="24" />
                <RowDefinition Height="224" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="32">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="14"
                        Opacity="0.08"
                        RenderingBias="Quality"
                        ShadowDepth="0"
                        Color="#1F2023" />
                </Border.Effect>
                <Grid Margin="54">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="34"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        TextAlignment="Center">
                        <Run>얼굴 사진이 있는 부분을</Run>
                        <LineBreak />
                        <Run>아래로 하여 스캐너에 올려주세요.</Run>
                    </TextBlock>

                    <Border
                        Grid.Row="2"
                        Background="#D4DEEC"
                        CornerRadius="32">
                        <Grid ClipToBounds="True">
                            <controls:VideoPlayerControl
                                AutoPlay="True"
                                CornerRadius="32"
                                Loop="True"
                                MediaStretch="UniformToFill"
                                SourcePath="{Binding PreviewVideoPath}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Padding="52,0"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="32">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="14"
                        Opacity="0.08"
                        RenderingBias="Quality"
                        ShadowDepth="0"
                        Color="#1F2023" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        VerticalAlignment="Center"
                        FontSize="34"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentEmphasisForegroundBrush}"
                        Text="스캔 가능 신분증"
                        TextAlignment="Center" />
                    <Rectangle Grid.Row="1" Fill="{StaticResource FeatureDividerBrush}" />
                    <TextBlock
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        FontSize="34"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="여권, 주민등록증, 운전면허증, 외국인등록증"
                        TextAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
