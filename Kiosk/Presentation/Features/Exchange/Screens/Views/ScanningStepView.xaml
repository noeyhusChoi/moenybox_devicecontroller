<UserControl
    x:Class="Kiosk.Views.Steps.ScanningStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Focusable="False" KeyboardNavigation.IsTabStop="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,208,0,0" HorizontalAlignment="Center">
            <Image
                Width="360"
                Height="360"
                HorizontalAlignment="Center"
                Source="pack://application:,,,/Assets/Image/img_scan_ing.png"
                Stretch="Uniform" />
            <TextBlock
                Margin="0,78,0,0"
                HorizontalAlignment="Center"
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_L}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="신분증 스캔을 진행중입니다." />
            <TextBlock
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                FontSize="{StaticResource FontSize_S}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="잠시만 기다려주세요.." />
        </StackPanel>
        <Grid
            x:Name="ScanningActionContainer"
            Grid.Row="1"
            Width="336"
            Height="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            behavior:FocusBoundary.EntryTarget="{Binding ElementName=ScanningSecondaryButton}"
            behavior:FocusContainer.InitialFocus="True"
            behavior:FocusContainer.Mode="HorizontalStack"
            Focusable="False"
            KeyboardNavigation.IsTabStop="False">
            <Button
                x:Name="ScanningSecondaryButton"
                Command="{Binding SecondaryCommand}"
                IsEnabled="{Binding IsSecondaryEnabled}"
                Style="{StaticResource OutlinedActionSecondaryButtonStyle}">
                <TextBlock Text="이전" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
