<UserControl
    x:Class="Kiosk.Views.Steps.ScanningStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="224" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="{Binding Title}" />

        <Border
            Grid.Row="1"
            Padding="48"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            BorderThickness="1"
            CornerRadius="36">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="34"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="신분증 스캔 진행 중" />
                    <Border
                        Grid.Column="1"
                        Padding="18,8"
                        Background="{DynamicResource AccentSurfaceBackgroundBrush}"
                        CornerRadius="20">
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentForegroundBrush}"
                            Text="{Binding Presence}" />
                    </Border>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Grid Width="220" Height="220">
                        <Ellipse Fill="{DynamicResource AccentSurfaceBackgroundBrush}" />
                        <Border
                            Width="120"
                            Height="84"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentBackgroundBrush}"
                            CornerRadius="18" />
                    </Grid>
                    <TextBlock
                        Margin="0,28,0,0"
                        FontSize="28"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding Body}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding ProgressMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,16,0,0"
                        FontSize="20"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="스캐너 상태를 확인해 주세요."
                        TextAlignment="Center"
                        Visibility="{Binding IsFaulted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
