<UserControl
    x:Class="Kiosk.Views.HomeScreenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:Kiosk.Application.Services.Resx"
    behavior:FocusBoundary.EntryTarget="{Binding ElementName=ServiceCardContainer}"
    d:DesignHeight="1705"
    d:DesignWidth="1080"
    d:Language="ko-KR"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ServiceCardTitleTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource FontSize_L}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_L}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ServiceCardSubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,0" />
            <Setter Property="FontSize" Value="{StaticResource FontSize_XS}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_M}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="72" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="190" />
            <RowDefinition Height="160" />
            <RowDefinition Height="124" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_L}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{resx:ResxLoc Menu.Title}"
                TextAlignment="Center" />
            <TextBlock
                Margin="0,21,0,0"
                FontSize="{StaticResource FontSize_S}"
                FontWeight="{StaticResource FontWeight_L}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="Please select the service"
                TextAlignment="Center" />
        </StackPanel>

        <Grid
            x:Name="ServiceCardContainer"
            Grid.Row="3"
            VerticalAlignment="Top"
            behavior:FocusContainer.InitialFocus="True"
            behavior:FocusContainer.Mode="VerticalStack">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                x:Name="TransportationCardButton"
                Grid.Row="0"
                Height="310"
                Margin="0,0,0,32"
                Command="{Binding Command}"
                DataContext="{Binding TransportationCard}"
                IsEnabled="{Binding IsEnabled}"
                Style="{StaticResource FilledWhiteButtonStyle}">
                <Grid Margin="90,52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Foreground="{DynamicResource OnDefaultPrimaryBrush}"
                            Style="{StaticResource ServiceCardTitleTextStyle}"
                            Text="교통선불카드" />
                        <TextBlock Foreground="{DynamicResource OnDefaultSecondaryBrush}" Style="{StaticResource ServiceCardSubtitleTextStyle}">
                            <Run FontFamily="{StaticResource AppFont}" Text="Prepaid Card" />
                            <Run Text="•" />
                            <Run Text="プリペイドカード" />
                            <LineBreak />
                            <Run Text="预付卡" />
                            <Run Text="•" />
                            <Run Text="預付卡" />
                        </TextBlock>
                    </StackPanel>

                    <Image
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{Binding IconAssetPath}"
                        Stretch="Uniform" />
                </Grid>
            </Button>

            <Button
                x:Name="ExchangeCardButton"
                Grid.Row="1"
                Height="310"
                Margin="0,0,0,32"
                behavior:FocusContainer.IsPreferredFocus="True"
                Command="{Binding Command}"
                DataContext="{Binding ExchangeCard}"
                IsEnabled="{Binding IsEnabled}"
                Style="{StaticResource FilledPrimaryButtonStyle}">
                <Grid Margin="90,52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Foreground="{DynamicResource OnAccentPrimaryBrush}"
                            Style="{StaticResource ServiceCardTitleTextStyle}"
                            Text="환전" />
                        <TextBlock Foreground="{DynamicResource OnAccentSecondaryBrush}" Style="{StaticResource ServiceCardSubtitleTextStyle}">
                            <Run Text="Exchange Card" />
                            <Run Text="•" />
                            <Run Text="外貨両替 " />
                            <LineBreak />
                            <Run Text="外币兑换" />
                            <Run Text="•" />
                            <Run Text="外幣兌換" />
                        </TextBlock>
                    </StackPanel>

                    <Image
                        Grid.Column="1"
                        Width="160"
                        Height="160"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{Binding IconAssetPath}"
                        Stretch="Uniform" />
                </Grid>
            </Button>

            <Button
                x:Name="TaxRefundCardButton"
                Grid.Row="2"
                Height="310"
                Command="{Binding Command}"
                DataContext="{Binding TaxRefundCard}"
                IsEnabled="{Binding IsEnabled}"
                Style="{StaticResource FilledDarkButtonStyle}">
                <Grid Margin="90,52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Foreground="{DynamicResource OnStrongPrimaryBrush}"
                            Style="{StaticResource ServiceCardTitleTextStyle}"
                            Text="택스리펀드" />
                        <TextBlock Foreground="{DynamicResource OnStrongSecondaryBrush}" Style="{StaticResource ServiceCardSubtitleTextStyle}">
                            <Run Text="Tax Refund" />
                            <Run Text="•" />
                            <Run Text="免税" />
                            <LineBreak />
                            <Run Text="退税" />
                            <Run Text="•" />
                            <Run Text="退稅" />
                        </TextBlock>
                    </StackPanel>

                    <Image
                        Grid.Column="1"
                        Width="160"
                        Height="160"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{Binding IconAssetPath}"
                        Stretch="Uniform" />
                </Grid>
            </Button>
        </Grid>
    </Grid>
</UserControl>
