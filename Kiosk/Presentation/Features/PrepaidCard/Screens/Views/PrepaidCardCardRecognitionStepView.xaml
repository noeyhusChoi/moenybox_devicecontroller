<UserControl
    x:Class="Kiosk.Views.PrepaidCard.PrepaidCardCardRecognitionStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="180" />
            <RowDefinition Height="217" />
            <RowDefinition Height="752" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="1">
            <TextBlock.Style>
                <Style BasedOn="{StaticResource ExchangeStepTitleStyle}" TargetType="TextBlock">
                    <Setter Property="Text" Value="선불카드를 투입해주세요" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PreviewImageSource}" Value="pack://application:,,,/Assets/Image/img_ezl.png">
                            <Setter Property="Text" Value="교통선불카드를 투입해주세요" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Button
            x:Name="RecognitionPreviewButton"
            Grid.Row="2"
            Margin="0,0,0,24"
            Command="{Binding PrimaryCommand}"
            FocusVisualStyle="{x:Null}"
            Style="{StaticResource FilledWhiteButtonStyle}">
            <Grid Margin="48">
                <Image
                    Source="{Binding PreviewImageSource}"
                    Stretch="Uniform" />
            </Grid>
        </Button>

        <Button
            x:Name="PreviousActionButton"
            Grid.Row="3"
            Width="336"
            Height="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            behavior:FocusBoundary.UpTarget="{Binding ElementName=RecognitionPreviewButton}"
            behavior:FocusContainer.InitialFocus="True"
            behavior:FocusContainer.Mode="VerticalStack"
            Command="{Binding SecondaryCommand}"
            IsEnabled="{Binding IsSecondaryEnabled}"
            Style="{StaticResource OutlinedActionSecondaryButtonStyle}">
            <TextBlock Text="이전" />
        </Button>
    </Grid>
</UserControl>
