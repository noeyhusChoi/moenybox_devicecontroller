<UserControl
    x:Class="Kiosk.Views.PrepaidCard.PrepaidCardCashResultStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1455"
    d:DesignWidth="1080"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ResultLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize_XS}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_M}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ResultValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_L}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ResultCurrencyStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_M}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ResultAccentValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ResultValueStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}" />
        </Style>

        <Style x:Key="ResultAccentCurrencyStyle" TargetType="TextBlock" BasedOn="{StaticResource ResultCurrencyStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <Border
                Width="120"
                Height="120"
                HorizontalAlignment="Center"
                CornerRadius="60">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource StatusSuccessBackgroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                <Setter Property="Background" Value="#E5484D" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource AppFont}"
                        FontSize="72"
                        FontWeight="{StaticResource FontWeight_L}"
                        Foreground="White"
                        Text="!">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Path
                        Width="52"
                        Height="38"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 4,20 L 18,34 L 48,6"
                        Stretch="Uniform"
                        Stroke="{DynamicResource StatusSuccessForegroundBrush}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="8">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Border>

            <TextBlock
                Margin="0,32,0,0"
                Style="{StaticResource ExchangeStepTitleStyle}"
                Text="{Binding ResultTitle, Mode=OneWay}" />
        </StackPanel>

        <Border
            Grid.Row="2"
            Padding="54"
            Style="{StaticResource CardSurfaceBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Style="{StaticResource ResultLabelStyle}"
                    Text="{Binding ChargeSummaryLabel, Mode=OneWay}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock
                        Style="{StaticResource ResultValueStyle}"
                        Text="{Binding ChargeAmountNumberText, Mode=OneWay}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        Style="{StaticResource ResultCurrencyStyle}"
                        Text="{Binding ChargeAmountCurrencyText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="4"
            Padding="54"
            Style="{StaticResource CardSurfaceBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{DynamicResource AppFont}"
                    FontSize="{StaticResource FontSize_S}"
                    FontWeight="{StaticResource FontWeight_L}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="충전 후 지갑 잔액"
                    TextAlignment="Center" />

                <Border
                    Grid.Row="2"
                    Padding="40,32"
                    Background="{DynamicResource AppBackgroundBrush}"
                    CornerRadius="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            FontWeight="{StaticResource FontWeight_L}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Style="{StaticResource ResultLabelStyle}"
                            Text="{Binding WalletName, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock
                                Style="{StaticResource ResultAccentValueStyle}"
                                Text="{Binding WalletBalanceAfterChargeNumberText, Mode=OneWay}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Style="{StaticResource ResultAccentCurrencyStyle}"
                                Text="{Binding WalletBalanceAfterChargeCurrencyText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid
            x:Name="ResultActionContainer"
            Grid.Row="6"
            behavior:FocusContainer.InitialFocus="True"
            behavior:FocusContainer.Mode="HorizontalStack"
            Focusable="False"
            KeyboardNavigation.IsTabStop="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Command="{Binding SecondaryCommand}"
                IsEnabled="{Binding IsSecondaryEnabled}"
                Style="{StaticResource OutlinedActionSecondaryButtonStyle}">
                <TextBlock Text="영수증 미출력" />
            </Button>

            <Button
                Grid.Column="2"
                Command="{Binding PrimaryCommand}"
                IsEnabled="{Binding IsPrimaryEnabled}"
                Style="{StaticResource FilledActionPrimaryButtonStyle}">
                <TextBlock Text="영수증 출력" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
