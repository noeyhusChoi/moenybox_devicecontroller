<UserControl
    x:Class="Kiosk.Views.PrepaidCard.PrepaidCardChargeMethodSelectionStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ChargeOptionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize_M}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_L}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="Foreground" Value="{DynamicResource OnDefaultPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ChargeOptionDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="{StaticResource FontSize_XS}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_M}" />
            <Setter Property="Foreground" Value="{DynamicResource OnDefaultSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="180" />
            <RowDefinition Height="217" />
            <RowDefinition Height="105" />
            <RowDefinition Height="752" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1">
            <TextBlock Style="{StaticResource ExchangeStepTitleStyle}" Text="충전 방식을 선택해 주세요" />
            <TextBlock
                Margin="0,24,0,0"
                FontSize="{StaticResource FontSize_S}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap">
                <Run>카드 구매 비용은 5,000KRW 이며,</Run>
                <LineBreak />
                <Run>충전 금액과 별도로 결제됩니다.</Run>
            </TextBlock>
        </StackPanel>

        <Grid
            x:Name="ChargeMethodOptionContainer"
            Grid.Row="3"
            behavior:FocusBoundary.DownTarget="{Binding ElementName=PreviousActionButton}"
            behavior:FocusContainer.InitialFocus="True"
            behavior:FocusContainer.Mode="VerticalStack"
            Focusable="False"
            KeyboardNavigation.DirectionalNavigation="Continue"
            KeyboardNavigation.IsTabStop="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="360" />
                <RowDefinition Height="32" />
                <RowDefinition Height="360" />
            </Grid.RowDefinitions>

            <Button Command="{Binding ChargeBothWalletsCommand}" Style="{StaticResource FilledWhiteButtonStyle}">
                <Grid Margin="80,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource ChargeOptionTitleStyle}" Text="선불지갑 및 교통지갑 충전" />
                        <TextBlock Style="{StaticResource ChargeOptionDescriptionStyle}" Text="원하는 지갑만 또는 둘 다 충전 가능" />
                        <TextBlock Style="{StaticResource ChargeOptionDescriptionStyle}">
                            <Run>결제:</Run>
                            <Run Foreground="{DynamicResource TextAccentBrush}">현금</Run>
                        </TextBlock>
                    </StackPanel>

                    <Image
                        Grid.Column="1"
                        Width="200"
                        Height="200"
                        Source="pack://application:,,,/Assets/Image/img_prepay_ezl.png"
                        Stretch="Uniform" />
                </Grid>
            </Button>

            <Button
                Grid.Row="2"
                Command="{Binding ChargeTrafficWalletOnlyCommand}"
                Style="{StaticResource FilledWhiteButtonStyle}">
                <Grid Margin="80,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource ChargeOptionTitleStyle}" Text="교통지갑만 충전" />
                        <TextBlock Style="{StaticResource ChargeOptionDescriptionStyle}">
                            <Run>결제:</Run>
                            <Run Foreground="{DynamicResource TextAccentBrush}">Alipay, WeChat Pay</Run>
                        </TextBlock>
                    </StackPanel>

                    <Image
                        Grid.Column="1"
                        Width="200"
                        Height="200"
                        Source="pack://application:,,,/Assets/Image/img_ezl.png"
                        Stretch="Uniform" />
                </Grid>
            </Button>
        </Grid>

        <Button
            x:Name="PreviousActionButton"
            Grid.Row="4"
            Width="336"
            Height="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            behavior:FocusBoundary.UpTarget="{Binding ElementName=ChargeMethodOptionContainer}"
            Command="{Binding SecondaryCommand}"
            IsEnabled="{Binding IsSecondaryEnabled}"
            Style="{StaticResource OutlinedActionSecondaryButtonStyle}">
            <TextBlock Text="이전" />
        </Button>
    </Grid>
</UserControl>
