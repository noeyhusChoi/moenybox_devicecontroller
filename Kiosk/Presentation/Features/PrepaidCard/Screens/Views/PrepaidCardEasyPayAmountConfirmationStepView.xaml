<UserControl
    x:Class="Kiosk.Views.PrepaidCard.PrepaidCardEasyPayAmountConfirmationStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1455"
    d:DesignWidth="1080"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="AmountConfirmLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize_XS}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_M}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AmountConfirmNumberStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize_XS}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_L}" />
            <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AmountConfirmCurrencyStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_M}" />
            <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="72" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="금액을 확인해주세요" />

        <Border
            Grid.Row="2"
            Width="936"
            Padding="54"
            HorizontalAlignment="Center"
            Style="{StaticResource CardSurfaceBorderStyle}">
            <Grid
                behavior:FocusBoundary.DownTarget="{Binding ElementName=PaymentActionButton}"
                behavior:FocusContainer.InitialFocus="True"
                behavior:FocusContainer.Mode="VerticalStack"
                Focusable="False"
                KeyboardNavigation.IsTabStop="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="110" />
                </Grid.RowDefinitions>

                <Border
                    Padding="48,40"
                    Background="{DynamicResource AppBackgroundBrush}"
                    CornerRadius="32">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource AmountConfirmLabelStyle}" Text="교통지갑 충전금액" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource AmountConfirmNumberStyle}" Text="{Binding ChargeAmountNumberText, Mode=OneWay}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Style="{StaticResource AmountConfirmCurrencyStyle}"
                                Text="{Binding ChargeAmountCurrencyText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Button
                    Grid.Row="2"
                    Command="{Binding SecondaryCommand}"
                    IsEnabled="{Binding IsSecondaryEnabled}"
                    Style="{StaticResource OutlinedActionSecondaryButtonStyle}">
                    <TextBlock Text="충전금액 수정" />
                </Button>
            </Grid>
        </Border>

        <Button
            x:Name="PaymentActionButton"
            Grid.Row="4"
            Command="{Binding PrimaryCommand}"
            IsEnabled="{Binding IsPrimaryEnabled}"
            Style="{StaticResource FilledActionPrimaryButtonStyle}">
            <TextBlock Text="결제하기" />
        </Button>
    </Grid>
</UserControl>
