<UserControl
    x:Class="Kiosk.Views.PrepaidCard.PrepaidCardEasyPayAmountEntryStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svg="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
    d:DesignHeight="1455"
    d:DesignWidth="1080"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="EasyPaySummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize_XS}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_L}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="EasyPayWalletTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize_S}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_L}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="EasyPayAmountNumberStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="59" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_L}" />
            <Setter Property="Foreground" Value="{DynamicResource TextAccentStrongBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style x:Key="EasyPayAmountCurrencyStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_M}" />
            <Setter Property="Foreground" Value="{DynamicResource TextAccentStrongBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="12,0,0,6" />
        </Style>

        <Style x:Key="EasyPayMetaStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize_XS}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_M}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="EasyPayIncrementPrimaryTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_L}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="EasyPayIncrementSecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize_XS}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_M}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="EasyPayIncrementButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="84" />
            <Setter Property="Background" Value="{DynamicResource SurfaceDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="8,12,8,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource SurfaceDefaultPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="충전 금액을 설정하세요" />

        <Border
            Grid.Row="2"
            Width="936"
            HorizontalAlignment="Center"
            Background="{DynamicResource CardPrimaryBackgroundBrush}"
            CornerRadius="32"
            Effect="{DynamicResource FilledCardButtonShadowEffect}">
            <TextBlock
                Margin="45"
                HorizontalAlignment="Center"
                Style="{StaticResource EasyPaySummaryLabelStyle}">
                <Run Text="교통지갑 잔여금액 :" />
                <Run Text=" " />
                <Run Text="{Binding TrafficWalletBalanceNumberText, Mode=OneWay}" />
                <Run Text=" " />
                <Run Text="{Binding TrafficWalletBalanceCurrencyText, Mode=OneWay}" />
            </TextBlock>
        </Border>

        <Border
            Grid.Row="4"
            Style="{StaticResource CardSurfaceBorderStyle}">
            <Grid Margin="48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource EasyPayWalletTitleStyle}" Text="교통지갑" />

                <Border
                    Grid.Row="2"
                    Background="{DynamicResource AppBackgroundBrush}"
                    CornerRadius="32">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Style="{StaticResource EasyPayAmountNumberStyle}"
                                Text="{Binding ChargeAmountNumberText, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource EasyPayAmountCurrencyStyle}"
                                Text="{Binding ChargeAmountCurrencyText, Mode=OneWay}" />
                        </StackPanel>

                        <TextBlock
                            Margin="0,24,0,0"
                            Style="{StaticResource EasyPayMetaStyle}">
                            <Run Text="최대 충전 가능 금액:" />
                            <Run Text=" " />
                            <Run Text="{Binding MaxChargeableAmountNumberText, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding MaxChargeableAmountCurrencyText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Grid
                    x:Name="EasyPayIncrementContainer"
                    Grid.Row="4"
                    behavior:FocusBoundary.DownTarget="{Binding ElementName=EasyPayPrimaryActionButton}"
                    behavior:FocusContainer.InitialFocus="True"
                    behavior:FocusContainer.Mode="UniformGrid"
                    Focusable="False"
                    KeyboardNavigation.IsTabStop="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="3" Rows="1">
                        <Button Margin="0,0,8,0" Command="{Binding AddOneThousandCommand}" Style="{StaticResource EasyPayIncrementButtonStyle}">
                            <TextBlock Style="{StaticResource EasyPayIncrementPrimaryTextStyle}" Text="+ 1,000" />
                        </Button>
                        <Button Margin="8,0,8,0" Command="{Binding AddFiveThousandCommand}" Style="{StaticResource EasyPayIncrementButtonStyle}">
                            <TextBlock Style="{StaticResource EasyPayIncrementPrimaryTextStyle}" Text="+ 5,000" />
                        </Button>
                        <Button Margin="8,0,0,0" Command="{Binding AddTenThousandCommand}" Style="{StaticResource EasyPayIncrementButtonStyle}">
                            <TextBlock Style="{StaticResource EasyPayIncrementPrimaryTextStyle}" Text="+ 10,000" />
                        </Button>
                    </UniformGrid>

                    <UniformGrid Grid.Row="2" Columns="3" Rows="1">
                        <Button Margin="0,0,8,0" Command="{Binding AddFiftyThousandCommand}" Style="{StaticResource EasyPayIncrementButtonStyle}">
                            <TextBlock Style="{StaticResource EasyPayIncrementPrimaryTextStyle}" Text="+ 50,000" />
                        </Button>
                        <Button Margin="8,0,8,0" Command="{Binding AddMaxCommand}" Style="{StaticResource EasyPayIncrementButtonStyle}">
                            <TextBlock Style="{StaticResource EasyPayIncrementSecondaryTextStyle}" Text="+ 최대금액" />
                        </Button>
                        <Button Margin="8,0,0,0" Command="{Binding ResetCommand}" Style="{StaticResource EasyPayIncrementButtonStyle}">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <svg:SvgIcon
                                    Width="24"
                                    Height="24"
                                    Margin="0,2,8,0"
                                    AppName="KIOSK"
                                    Fill="{DynamicResource TextPrimaryBrush}"
                                    Stroke="{DynamicResource TextPrimaryBrush}"
                                    UriSource="pack://application:,,,/KIOSK;component/Assets/Icon/ico_arrow-rotate.svg" />
                                <TextBlock Style="{StaticResource EasyPayIncrementSecondaryTextStyle}" Text="초기화" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Grid>
        </Border>

        <Button
            x:Name="EasyPayPrimaryActionButton"
            Grid.Row="6"
            Command="{Binding PrimaryCommand}"
            IsEnabled="{Binding IsPrimaryEnabled}"
            Style="{StaticResource FilledActionPrimaryButtonStyle}">
            <TextBlock Text="다음" />
        </Button>
    </Grid>
</UserControl>
