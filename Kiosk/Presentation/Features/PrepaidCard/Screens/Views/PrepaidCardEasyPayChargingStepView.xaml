<UserControl
    x:Class="Kiosk.Views.PrepaidCard.PrepaidCardEasyPayChargingStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1455"
    d:DesignWidth="1080"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="190" />
            <RowDefinition Height="530" />
            <RowDefinition Height="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Image
                Width="638"
                Height="425"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="pack://application:,,,/Assets/Image/img_mascot.png"
                Stretch="Uniform" />
        </Grid>

        <StackPanel Grid.Row="3" HorizontalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AppFont}"
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_L}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="교통지갑 충전중입니다"
                TextAlignment="Center" />

            <TextBlock
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AppFont}"
                FontSize="{StaticResource FontSize_S}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="잠시만 기다려주세요..."
                TextAlignment="Center" />
        </StackPanel>

        <Grid
            x:Name="ChargingActionContainer"
            Grid.Row="5"
            behavior:FocusContainer.InitialFocus="True"
            behavior:FocusContainer.Mode="HorizontalStack"
            Focusable="False"
            KeyboardNavigation.IsTabStop="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Command="{Binding SecondaryCommand}"
                IsEnabled="{Binding IsSecondaryEnabled}"
                Style="{StaticResource OutlinedActionSecondaryButtonStyle}">
                <TextBlock Text="실패 처리" />
            </Button>

            <Button
                Grid.Column="2"
                Command="{Binding PrimaryCommand}"
                IsEnabled="{Binding IsPrimaryEnabled}"
                Style="{StaticResource FilledActionPrimaryButtonStyle}">
                <TextBlock Text="충전 완료" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
