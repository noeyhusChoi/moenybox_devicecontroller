<UserControl
    x:Class="Kiosk.Views.PrepaidCard.PrepaidCardEasyPayCompletionStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1645"
    d:DesignWidth="1080"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="355" />
            <RowDefinition Height="500" />
            <RowDefinition Height="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Image
                Width="780"
                Height="452"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="pack://application:,,,/Assets/Image/img_mascot.png"
                Stretch="Uniform" />
        </Grid>

        <StackPanel Grid.Row="3" HorizontalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AppFont}"
                FontSize="{StaticResource FontSize_XL}"
                FontWeight="{StaticResource FontWeight_L}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="이용해주셔서 감사합니다"
                TextAlignment="Center" />

            <TextBlock
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource AppFont}"
                FontSize="{StaticResource FontSize_S}"
                FontWeight="{StaticResource FontWeight_M}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                TextAlignment="Center">
                <Run Text="머니박스는 편하고 즐거운 환전이 되도록" />
                <LineBreak />
                <Run Text="항상 노력하고 있습니다" />
            </TextBlock>
        </StackPanel>

        <Button
            Grid.Row="5"
            HorizontalAlignment="Stretch"
            Command="{Binding PrimaryCommand}"
            IsEnabled="{Binding IsPrimaryEnabled}"
            Style="{StaticResource FilledActionPrimaryButtonStyle}">
            <TextBlock Text="첫화면으로 이동" />
        </Button>
    </Grid>
</UserControl>
