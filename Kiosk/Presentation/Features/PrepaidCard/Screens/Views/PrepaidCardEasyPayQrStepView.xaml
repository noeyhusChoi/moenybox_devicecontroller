<UserControl
    x:Class="Kiosk.Views.PrepaidCard.PrepaidCardEasyPayQrStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1455"
    d:DesignWidth="1080"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="56" />
            <RowDefinition Height="900" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="{Binding PaymentMethodKoreanName, Mode=OneWay, StringFormat={}{0} QR을 스캔해 주세요}" />

        <Border
            Grid.Row="2"
            Width="936"
            HorizontalAlignment="Center"
            Style="{StaticResource CardSurfaceBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="212" />
                    <RowDefinition Height="537" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  설명  -->
                <TextBlock
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource AppFont}"
                    FontSize="{StaticResource FontSize_S}"
                    FontWeight="{StaticResource FontWeight_M}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="QR코드를 스캔해 결제를 완료해주세요." />


                <!--  폰 레이아웃  -->
                <Grid Grid.Row="1" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="432" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="0" />
                        <RowDefinition Height="48" />
                        <RowDefinition Height="58" />
                        <RowDefinition Height="43" />
                        <RowDefinition Height="200" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Phone frame  -->
                    <Border
                        Grid.RowSpan="6"
                        Background="Transparent"
                        BorderBrush="{DynamicResource UtilityBarBackgroundBrush}"
                        BorderThickness="8,8,8,0"
                        CornerRadius="40,40,0,0" />

                    <!--  Speaker  -->
                    <Border
                        Grid.Row="1"
                        Width="110"
                        Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource UtilityBarBackgroundBrush}"
                        CornerRadius="9" />

                    <!--  QR + guide area  -->
                    <Grid
                        Grid.Row="3"
                        Grid.RowSpan="3"
                        Width="286"
                        Height="286"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">

                        <!--  Guide corners  -->
                        <Path
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Data="M 56,3 H 12 C 7,3 3,7 3,12 V 56"
                            Stroke="{DynamicResource UtilityBarBackgroundBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="6" />

                        <Path
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Data="M 4,3 H 48 C 53,3 57,7 57,12 V 56"
                            Stroke="{DynamicResource UtilityBarBackgroundBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="6" />

                        <Path
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Data="M 3,4 V 48 C 3,53 7,57 12,57 H 56"
                            Stroke="{DynamicResource UtilityBarBackgroundBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="6" />

                        <Path
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Data="M 57,4 V 48 C 57,53 53,57 48,57 H 4"
                            Stroke="{DynamicResource UtilityBarBackgroundBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="6" />

                        <!--  QR slot  -->
                        <Border
                            Width="200"
                            Height="200"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            CornerRadius="16">
                            <Image Source="{Binding QrImageSource}" Stretch="UniformToFill" />
                        </Border>
                    </Grid>

                    <!--  Payment icon card  -->
                    <Border
                        Grid.Row="4"
                        Width="140"
                        Height="140"
                        Margin="0,0,-90,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="{DynamicResource UtilityBarBackgroundBrush}"
                        CornerRadius="28">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="14"
                                Opacity="0.08"
                                ShadowDepth="0"
                                Color="#1F2023" />
                        </Border.Effect>

                        <Image
                            Margin="0"
                            Source="{Binding PaymentIconSource}"
                            Stretch="UniformToFill" />
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource UtilityBarBackgroundBrush}" />

                <!--  총 결제금액  -->
                <TextBlock
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run
                        FontFamily="{DynamicResource AppFont}"
                        FontSize="{StaticResource FontSize_XS}"
                        FontWeight="{StaticResource FontWeight_M}"
                        Text="총 결제금액 :" />
                    <Run Text=" " />
                    <Run
                        FontFamily="{DynamicResource AppFont}"
                        FontSize="{StaticResource FontSize_XS}"
                        FontWeight="{StaticResource FontWeight_M}"
                        Foreground="{DynamicResource TextAccentBrush}"
                        Text="{Binding ChargeAmountNumberText, Mode=OneWay}" />
                    <Run Text=" " />
                    <Run
                        FontFamily="{DynamicResource AppFont}"
                        FontSize="{StaticResource FontSize_XS}"
                        FontWeight="{StaticResource FontWeight_M}"
                        Foreground="{DynamicResource TextAccentBrush}"
                        Text="{Binding ChargeAmountCurrencyText, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>

        <Grid
            x:Name="QrActionContainer"
            Grid.Row="4"
            behavior:FocusContainer.InitialFocus="True"
            behavior:FocusContainer.Mode="HorizontalStack"
            Focusable="False"
            KeyboardNavigation.IsTabStop="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Command="{Binding SecondaryCommand}"
                IsEnabled="{Binding IsSecondaryEnabled}"
                Style="{StaticResource OutlinedActionSecondaryButtonStyle}">
                <TextBlock Text="이전" />
            </Button>

            <Button
                Grid.Column="2"
                Command="{Binding PrimaryCommand}"
                IsEnabled="{Binding IsPrimaryEnabled}"
                Style="{StaticResource FilledActionPrimaryButtonStyle}">
                <TextBlock Text="결제 완료" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
