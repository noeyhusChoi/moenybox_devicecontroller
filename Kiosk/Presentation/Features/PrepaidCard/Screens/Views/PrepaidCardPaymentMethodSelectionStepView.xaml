<UserControl
    x:Class="Kiosk.Views.PrepaidCard.PrepaidCardPaymentMethodSelectionStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Focusable="False"
    IsTabStop="False"
    KeyboardNavigation.IsTabStop="False"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="PaymentMethodIconLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize_XS}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight_L}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="PaymentMethodOptionButtonStyle"
            BasedOn="{StaticResource FilledWhiteButtonStyle}"
            TargetType="Button" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="180" />
            <RowDefinition Height="162" />
            <RowDefinition Height="160" />
            <RowDefinition Height="752" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="1"
            Style="{StaticResource ExchangeStepTitleStyle}"
            Text="결제 방법을 선택해주세요" />

        <Grid
            x:Name="PaymentMethodOptionContainer"
            Grid.Row="3"
            behavior:FocusBoundary.DownTarget="{Binding ElementName=PreviousActionButton}"
            behavior:FocusContainer.InitialFocus="True"
            behavior:FocusContainer.Mode="VerticalStack"
            Focusable="False"
            KeyboardNavigation.DirectionalNavigation="Continue"
            KeyboardNavigation.IsTabStop="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button
                Grid.Row="0"
                Command="{Binding CashCommand}"
                Style="{StaticResource PaymentMethodOptionButtonStyle}">
                <Grid Margin="80,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource ExchangeStepTitleStyle}"
                        Text="지폐" />

                    <Image
                        Grid.Column="1"
                        Width="140"
                        Height="140"
                        HorizontalAlignment="Center"
                        Source="pack://application:,,,/Assets/Image/img_bills.png"
                        Stretch="Uniform" />
                </Grid>
            </Button>

            <Button
                Grid.Row="2"
                Command="{Binding AlipayCommand}"
                Style="{StaticResource PaymentMethodOptionButtonStyle}">
                <Grid Margin="80,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource ExchangeStepTitleStyle}"
                        Text="알리페이" />

                    <Border
                        Grid.Column="1"
                        Width="140"
                        Height="140"
                        HorizontalAlignment="Center"
                        Background="#1677FF"
                        CornerRadius="28">
                        <TextBlock Style="{StaticResource PaymentMethodIconLabelStyle}" Text="Alipay" />
                    </Border>
                </Grid>
            </Button>

            <Button
                Grid.Row="4"
                Command="{Binding WechatPayCommand}"
                Style="{StaticResource PaymentMethodOptionButtonStyle}">
                <Grid Margin="80,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource ExchangeStepTitleStyle}"
                        Text="위챗페이" />

                    <Border
                        Grid.Column="1"
                        Width="140"
                        Height="140"
                        HorizontalAlignment="Center"
                        Background="White"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="28">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource AppFont}"
                            FontSize="{StaticResource FontSize_XS}"
                            FontWeight="{StaticResource FontWeight_L}"
                            Foreground="#16B53B"
                            Text="WeChat" />
                    </Border>
                </Grid>
            </Button>
        </Grid>

        <Button
            x:Name="PreviousActionButton"
            Grid.Row="4"
            Width="336"
            Height="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            behavior:FocusBoundary.UpTarget="{Binding ElementName=PaymentMethodOptionContainer}"
            Command="{Binding SecondaryCommand}"
            IsEnabled="{Binding IsSecondaryEnabled}"
            Style="{StaticResource OutlinedActionSecondaryButtonStyle}">
            <TextBlock Text="이전" />
        </Button>
    </Grid>
</UserControl>
