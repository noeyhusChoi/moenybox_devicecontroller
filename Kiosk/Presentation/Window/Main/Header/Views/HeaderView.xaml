<UserControl
    x:Class="Kiosk.Views.HeaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:Kiosk.ViewModels"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="HeaderPanelVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Grid Width="1080" Height="100">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image
            Grid.Column="0"
            Height="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Source="{Binding LogoAssetPath}"
            Stretch="Uniform" />

        <Grid
            Grid.Column="1"
            Margin="0,25,40,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <Grid x:Name="DateTimePanel">
                <Grid.Style>
                    <Style BasedOn="{StaticResource HeaderPanelVisibilityStyle}" TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RightMode}" Value="{x:Static viewModels:HeaderRightMode.DateTime}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontSize="40"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="{Binding CurrentDateText}"
                    Typography.NumeralAlignment="Tabular" />
                <TextBlock
                    Grid.Column="2"
                    FontSize="40"
                    FontWeight="Medium"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="{Binding CurrentTimeText}"
                    Typography.NumeralAlignment="Tabular" />
            </Grid>

            <Grid x:Name="TimerPanel">
                <Grid.Style>
                    <Style BasedOn="{StaticResource HeaderPanelVisibilityStyle}" TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RightMode}" Value="{x:Static viewModels:HeaderRightMode.Timer}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    FontSize="38"
                    Foreground="{DynamicResource AccentForegroundBrush}"
                    Text="◔" />
                <TextBlock
                    Grid.Column="2"
                    FontSize="38"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="{Binding TimerText}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
