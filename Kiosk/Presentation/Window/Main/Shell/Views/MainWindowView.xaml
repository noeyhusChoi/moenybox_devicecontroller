<Window
    x:Class="Kiosk.MainWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:Kiosk.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:overlayViews="clr-namespace:Kiosk.Views.Overlays"
    xmlns:overlayVm="clr-namespace:Kiosk.ViewModels.Overlays"
    xmlns:viewModels="clr-namespace:Kiosk.ViewModels"
    xmlns:views="clr-namespace:Kiosk.Views"
    Title="Kiosk Rebuild"
    Width="1080"
    Height="1920"
    Background="{DynamicResource AppBackgroundBrush}"
    Loaded="Window_Loaded"
    PreviewKeyDown="Window_PreviewKeyDown"
    PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
    PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
    PreviewMouseMove="Window_PreviewMouseMove"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="OverlayContentControlStyle" TargetType="ContentControl">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type viewModels:HomeShellViewModel}">
            <views:HomeShellView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ExchangeEntryShellViewModel}">
            <views:ExchangeEntryShellView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CashExchangeShellViewModel}">
            <views:CashExchangeShellView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PrepaidCardShellViewModel}">
            <views:PrepaidCardShellView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type overlayVm:TermsOverlayViewModel}">
            <overlayViews:TermsOverlayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type overlayVm:PrepaidCardChargeAmountOverlayViewModel}">
            <overlayViews:PrepaidCardChargeAmountOverlayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type overlayVm:PrepaidCardDepositLimitOverlayViewModel}">
            <overlayViews:PrepaidCardDepositLimitOverlayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type overlayVm:AccessibilitySettingsOverlayViewModel}">
            <overlayViews:AccessibilitySettingsOverlayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type overlayVm:VoiceGuideOverlayViewModel}">
            <overlayViews:VoiceGuideOverlayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type overlayVm:ThemeSelectionOverlayViewModel}">
            <overlayViews:ThemeSelectionOverlayView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="105" />
                <RowDefinition Height="*" />
                <RowDefinition Height="170" />
            </Grid.RowDefinitions>

            <Grid Grid.RowSpan="2" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="{Binding AccessibilityZoomScale}" ScaleY="{Binding AccessibilityZoomScale}" />
                        <TranslateTransform X="{Binding AccessibilityPanX}" Y="{Binding AccessibilityPanY}" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <Grid.RowDefinitions>
                    <RowDefinition Height="105" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProgressChromeVisible}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ProgressBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <views:HeaderView DataContext="{Binding HeaderViewModel}" />
                </Border>

                <ContentControl
                    x:Name="ScreenHost"
                    Grid.Row="1"
                    behavior:FocusBoundary.DownTarget="{Binding ElementName=UtilityBarHost}"
                    behavior:FocusContainer.Mode="None"
                    Content="{Binding CurrentScreenViewModel}"
                    Focusable="False" />
            </Grid>

            <views:UtilityBarModernView
                x:Name="UtilityBarHost"
                Grid.Row="2"
                behavior:FocusBoundary.UpTarget="{Binding ElementName=ScreenHost}"
                behavior:FocusContainer.Mode="None"
                DataContext="{Binding UtilityBarViewModel}" />
        </Grid>

        <Border
            Width="{Binding MinimapWidth}"
            Height="{Binding MinimapHeight}"
            Margin="24"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="10"
            Background="{DynamicResource AccessibilityMinimapBackgroundBrush}"
            BorderBrush="{DynamicResource AccessibilityMinimapBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            IsHitTestVisible="False"
            Visibility="{Binding IsAccessibilityZoomEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid ClipToBounds="True">
                <Border
                    Margin="8"
                    Background="{DynamicResource AccessibilityMinimapSurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource AccessibilityMinimapSurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6" />

                <Canvas
                    Width="{Binding MinimapContentWidth}"
                    Height="{Binding MinimapContentHeight}"
                    Margin="8">
                    <Border
                        Canvas.Left="{Binding MinimapViewportLeft}"
                        Canvas.Top="{Binding MinimapViewportTop}"
                        Width="{Binding MinimapViewportWidth}"
                        Height="{Binding MinimapViewportHeight}"
                        Background="{DynamicResource AccessibilityMinimapViewportBackgroundBrush}"
                        BorderBrush="{DynamicResource AccessibilityMinimapViewportBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="6" />
                </Canvas>
            </Grid>
        </Border>

        <ContentControl
            Panel.ZIndex="30"
            Content="{Binding CurrentModalViewModel}"
            Style="{StaticResource OverlayContentControlStyle}" />

        <ContentControl
            Panel.ZIndex="31"
            Content="{Binding CurrentUtilityOverlayViewModel}"
            Style="{StaticResource OverlayContentControlStyle}" />
    </Grid>
</Window>
