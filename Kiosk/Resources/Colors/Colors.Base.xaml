    <Color x:Key="Gray700">#555A65</Color>
    <Color x:Key="Gray800">#40444A</Color>
    <Color x:Key="Gray900">#2B2E32</Color>
    <Color x:Key="Gray950">#303132</Color>
    <Color x:Key="Gray1000">#1A1A1A</Color>

