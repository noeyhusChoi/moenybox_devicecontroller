    <Color x:Key="Primary900">#022146</Color>

    <!--  Secondary  -->
    <Color x:Key="Secondary800">#033673</Color>

    <!--  Point mint  -->
    <Color x:Key="Point50">#C9FEFE</Color>
    <Color x:Key="Point200">#72F9F9</Color>
    <Color x:Key="Point500">#10D1D0</Color>
    <Color x:Key="Point700">#117878</Color>

    <!--  Gray scale  -->
