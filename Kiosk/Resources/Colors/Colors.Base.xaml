    <SolidColorBrush x:Key="BlueGray100Brush" Color="{StaticResource BlueGray100}" />
    <SolidColorBrush x:Key="BlueGray200Brush" Color="{StaticResource BlueGray200}" />

    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

    <!--  Compatibility aliases  -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary500}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary800}" />
    <SolidColorBrush x:Key="PointBrush" Color="{StaticResource Point500}" />
</ResourceDictionary>
