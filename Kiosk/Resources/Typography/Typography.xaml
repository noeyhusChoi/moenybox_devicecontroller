<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--<FontFamily x:Key="Pretendard">/kiosk;component/Assets/Fonts/#Pretendard Variable</FontFamily>-->
    <FontFamily x:Key="AppFont">/kiosk;component/Assets/Fonts/NotoSansCJK/#Noto Sans CJK KR</FontFamily>

    <!--  ========== 폰트 사이즈 토큰 ==========  -->
    <sys:Double x:Key="FontSize_XS">34</sys:Double>
    <sys:Double x:Key="FontSize_S">39</sys:Double>
    <sys:Double x:Key="FontSize_M">49</sys:Double>
    <sys:Double x:Key="FontSize_L">53</sys:Double>
    <sys:Double x:Key="FontSize_XL">59</sys:Double>

    <FontWeight x:Key="FontWeight_S">Regular</FontWeight>
    <FontWeight x:Key="FontWeight_M">Medium</FontWeight>
    <FontWeight x:Key="FontWeight_L">Bold</FontWeight>

    <Style x:Key="ExchangeStepTitleStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize_XL}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeight_L}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
